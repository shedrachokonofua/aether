model_list:
  # llama-swap (K8s) — AFFiNE Copilot streams via /v1/responses; bridge to chat/completions.
  # The qwen3.8-27b routes are one pinned llama-server (4 slots sharing a
  # 262144-token KV cache) with no second deployment to fail over to. A router
  # cooldown cannot add capacity: on 2026-09-25 one context overflow from two
  # concurrent tool-heavy chats became 5m of "No deployments available".
  - model_name: "aether/qwen3.8-27b"
    litellm_params:
      model: "openai/qwen3.8-27b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
      cooldown_time: 0
  - model_name: "aether/qwen3.8-27b:code"
    litellm_params:
      model: "openai/qwen3.8-27b:code"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
      cooldown_time: 0
  - model_name: "aether/qwen3.8-27b:think"
    litellm_params:
      model: "openai/qwen3.8-27b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
      cooldown_time: 0
  - model_name: "aether/qwen3.6-35b-a3b"
    litellm_params:
      model: "openai/qwen3.6-35b-a3b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/qwen3.6-35b-a3b:code"
    litellm_params:
      model: "openai/qwen3.6-35b-a3b:code"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/qwen3.6-35b-a3b:think"
    litellm_params:
      model: "openai/qwen3.6-35b-a3b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/qwen3.5-9b"
    litellm_params:
      model: "openai/qwen3.5-9b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/qwen3.5-9b:think"
    litellm_params:
      model: "openai/qwen3.5-9b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/gemma-4-31b"
    litellm_params:
      model: "openai/gemma-4-31b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/gemma-4-31b:think"
    litellm_params:
      model: "openai/gemma-4-31b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/gemma-4-26b-a4b"
    litellm_params:
      model: "openai/gemma-4-26b-a4b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/gemma-4-26b-a4b:think"
    litellm_params:
      model: "openai/gemma-4-26b-a4b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/muse-glimmer-30b"
    litellm_params:
      model: "openai/muse-glimmer-30b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/muse-glimmer-30b:think"
    litellm_params:
      model: "openai/muse-glimmer-30b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true

  # Clinepass models (https://api.cline.bot — OpenAI-compatible).
  # Cline legs are pins only (clinepass/*), not router members: Cline's
  # balance went negative and answered 402 on every draw (2026-09-03);
  # LiteLLM does not retry a 402 within the group, so one dead leg failed a
  # third of first requests. Re-add router/* legs when funded.
  - model_name: "clinepass/glm-5.3-flash"
    litellm_params:
      model: "openai/cline-pass/glm-5.3-flash"
      litellm_credential_name: clinepass_credential
  - model_name: "clinepass/qwen3.8-max"
    litellm_params:
      model: "openai/cline-pass/qwen3.8-max"
      litellm_credential_name: clinepass_credential
  - model_name: "clinepass/muse-spark-1.3"
    litellm_params:
      model: "openai/meta/muse-spark-1.3"
      litellm_credential_name: clinepass_credential
  - model_name: "clinepass/muse-spark-1.3-contributor"
    litellm_params:
      model: "openai/meta/muse-spark-1.3-contributor"
      litellm_credential_name: clinepass_credential
  - model_name: "clinepass/hy4-preview"
    litellm_params:
      model: "openai/tencent/hy4-preview"
      litellm_credential_name: clinepass_credential

  # CodeBuddy's Hy4 preview endpoint is stream-only and requires a leading
  # system message. Keep it standalone so generic router traffic cannot select it.
  - model_name: "codebuddy/hy4-preview"
    litellm_params:
      model: "openai/hy4-preview"
      litellm_credential_name: codebuddy_credential
      use_chat_completions_api: true
      # Preserve the upstream quota/reset error on this single-leg route.
      # A generic router cooldown cannot make the subscription allowance reset.
      cooldown_time: 0

  # Kimi Coding models (https://api.kimi.com/coding/v1 — OpenAI-compatible).
  - model_name: "kimi/k3"
    litellm_params:
      model: "openai/k3"
      litellm_credential_name: kimi_credential

  # Qwen Cloud models (https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1)
  - model_name: "qwen-cloud/qwen3.8-max"
    litellm_params:
      model: "openai/qwen3.8-max"
      litellm_credential_name: qwen_cloud_credential
  - model_name: "qwen-cloud/qwen3.8-flash"
    litellm_params:
      model: "openai/qwen3.8-flash"
      litellm_credential_name: qwen_cloud_credential

  # Step Plan subscription — no PAYG fallback.
  - model_name: "step/step-5-preview"
    litellm_params:
      model: "openai/step-5-preview"
      litellm_credential_name: step_credential

  # GLM 5.3 and GLM 5.3 Flash stay in separate model pools.
  - model_name: "router/glm-5.3"
    litellm_params:
      model: "zai/glm-5.3"
      litellm_credential_name: zai_credential
      weight: 4
  - model_name: "zai/glm-5.3-flash"
    litellm_params:
      model: "zai/glm-5.3-flash"
      litellm_credential_name: zai_credential
  - model_name: "router/glm-5.3-flash"
    litellm_params:
      model: "zai/glm-5.3-flash"
      litellm_credential_name: zai_credential

  # Command Code Muse models, including the separate Contributor route.
  - model_name: "commandcode/muse-spark-1.3"
    litellm_params:
      model: "openai/meta/muse-spark-1.3"
      litellm_credential_name: commandcode_credential
  - model_name: "router/muse-spark-1.3"
    litellm_params:
      model: "openai/meta/muse-spark-1.3"
      litellm_credential_name: commandcode_credential
  - model_name: "commandcode/muse-spark-1.3-contributor"
    litellm_params:
      model: "openai/meta/muse-spark-1.3-contributor"
      litellm_credential_name: commandcode_credential
  - model_name: "router/muse-spark-1.3-contributor"
    litellm_params:
      model: "openai/meta/muse-spark-1.3-contributor"
      litellm_credential_name: commandcode_credential
  - model_name: "commandcode/glm-5.3-flash"
    litellm_params:
      model: "openai/z-ai/glm-5.3-flash"
      litellm_credential_name: commandcode_credential
  - model_name: "router/glm-5.3-flash"
    litellm_params:
      model: "openai/z-ai/glm-5.3-flash"
      litellm_credential_name: commandcode_credential
  - model_name: "commandcode/hy4-preview"
    litellm_params:
      model: "openai/tencent/hy4-preview"
      litellm_credential_name: commandcode_credential
  - model_name: "router/hy4-preview"
    litellm_params:
      model: "openai/tencent/hy4-preview"
      litellm_credential_name: commandcode_credential

  # OpenCode Go (https://opencode.ai/zen/go/v1), including Muse Spark Contributor.
  - model_name: "opencode-go/muse-spark-1.3-contributor"
    litellm_params:
      model: "openai/muse-spark-1.3-contributor"
      litellm_credential_name: opencode_go_credential
  - model_name: "opencode-go/glm-5.3-flash"
    litellm_params:
      model: "openai/glm-5.3-flash"
      litellm_credential_name: opencode_go_credential
  - model_name: "router/glm-5.3-flash"
    litellm_params:
      model: "openai/glm-5.3-flash"
      litellm_credential_name: opencode_go_credential
  - model_name: "opencode-go/hy4-preview"
    litellm_params:
      model: "openai/hy4-preview"
      litellm_credential_name: opencode_go_credential
  - model_name: "router/hy4-preview"
    litellm_params:
      model: "openai/hy4-preview"
      litellm_credential_name: opencode_go_credential
  - model_name: "router/muse-spark-1.3-contributor"
    litellm_params:
      model: "openai/muse-spark-1.3-contributor"
      litellm_credential_name: opencode_go_credential

  # Ollama Cloud models
  - model_name: "ollama-cloud/glm-5.3-flash"
    litellm_params:
      model: "ollama_chat/glm-5.3-flash"
      litellm_credential_name: ollama_cloud_credential
  - model_name: "router/glm-5.3-flash"
    litellm_params:
      model: "ollama_chat/glm-5.3-flash"
      litellm_credential_name: ollama_cloud_credential
  - model_name: "router/glm-5.3"
    litellm_params:
      model: "ollama_chat/glm-5.3:cloud"
      litellm_credential_name: ollama_cloud_credential
      weight: 1
  - model_name: "router/deepseek-v4-pro"
    litellm_params:
      model: "ollama_chat/deepseek-v4-pro:cloud"
      litellm_credential_name: ollama_cloud_credential
  - model_name: "router/minimax-m3"
    litellm_params:
      model: "ollama_chat/minimax-m3"
      litellm_credential_name: ollama_cloud_credential

  # ChatGPT subscription OAuth — native Responses API; no PAYG fallback.
  # GPT-6 is not in LiteLLM's bundled catalog yet; declare native streaming.
  - model_name: "chatgpt/gpt-6-astra"
    litellm_params:
      model: "chatgpt/gpt-6-astra"
    model_info:
      mode: responses
      supports_native_streaming: true
  - model_name: "chatgpt/gpt-6-sol"
    litellm_params:
      model: "chatgpt/gpt-6-sol"
    model_info:
      mode: responses
      supports_native_streaming: true
  - model_name: "chatgpt/gpt-6-luna"
    litellm_params:
      model: "chatgpt/gpt-6-luna"
    model_info:
      mode: responses
      supports_native_streaming: true

  # Anthropic models — auto-inject cache_control on system messages (min 2048 tokens for 4.x).
  - model_name: "anthropic/claude-opus-4.8"
    litellm_params:
      model: "anthropic/claude-opus-4-8"
      litellm_credential_name: anthropic_credential
      cache_control_injection_points:
        - location: message
          role: system
  - model_name: "anthropic/claude-sonnet-4.6"
    litellm_params:
      model: "anthropic/claude-sonnet-4-6"
      litellm_credential_name: anthropic_credential
      cache_control_injection_points:
        - location: message
          role: system
  - model_name: "anthropic/claude-fable-5"
    litellm_params:
      model: "anthropic/claude-fable-5"
      litellm_credential_name: anthropic_credential
      cache_control_injection_points:
        - location: message
          role: system

  # Speech via llama-swap + audio.cpp (K8s)
  - model_name: "aether/qwen3-asr"
    litellm_params:
      model: "openai/qwen3-asr-0.6b"
      litellm_credential_name: llama_swap_credential
  - model_name: "aether/qwen3-tts"
    litellm_params:
      model: "openai/qwen3-tts-0.6b"
      litellm_credential_name: llama_swap_credential

  # Reranker + Embeddings via llama-swap (K8s)
  - model_name: "aether/bge-reranker-v2-m3"
    litellm_params:
      model: "openai/bge-reranker-v2-m3"
      litellm_credential_name: llama_swap_credential
  - model_name: "aether/qwen3-embedding:4b"
    litellm_params:
      model: "openai/qwen3-embedding-4b"
      litellm_credential_name: llama_swap_credential
      encoding_format: "float"
      additional_drop_params: ["dimensions"]
  - model_name: "aether/qwen3-embedding:0.6b"
    litellm_params:
      model: "openai/qwen3-embedding-0.6b"
      litellm_credential_name: llama_swap_credential
      encoding_format: "float"
      additional_drop_params: ["dimensions"]
  # AFFiNE 0.26.3 hardcodes gemini-embedding-001 for embed calls and accepts
  # text-embedding-3-large for the startup capability check (OpenAI provider builtin).
  # AFFiNE always sends dimensions=256; qwen backends ignore it — drop before LiteLLM validation.
  - model_name: "gemini-embedding-001"
    litellm_params:
      model: "openai/qwen3-embedding-0.6b"
      litellm_credential_name: llama_swap_credential
      encoding_format: "float"
      additional_drop_params: ["dimensions"]
  - model_name: "text-embedding-3-large"
    litellm_params:
      model: "openai/qwen3-embedding-0.6b"
      litellm_credential_name: llama_swap_credential
      encoding_format: "float"
      additional_drop_params: ["dimensions"]


  # Gemini Flash models through the single-tenant Antigravity bridge. Clients
  # own the tool loop and may select low/medium/high via reasoning_effort.
  - model_name: "antigravity/gemini-3.8-flash"
    litellm_params:
      model: "openai/antigravity/gemini-3.8-flash"
      litellm_credential_name: antigravity_credential
      use_chat_completions_api: true

  # Private Muse Code subscription bridge. This deployment never falls back to PAYG.
  - model_name: "meta/muse-spark-1.3"
    litellm_params:
      model: "openai/muse-subscription/muse-spark-1.3"
      litellm_credential_name: muse_bridge_credential
      use_chat_completions_api: true
  - model_name: "router/muse-spark-1.3"
    litellm_params:
      model: "openai/muse-subscription/muse-spark-1.3"
      litellm_credential_name: muse_bridge_credential
      use_chat_completions_api: true

  # The private subscription exposes only the standard model, but also backs
  # the Contributor router so unavailable public legs cannot stall callers.
  - model_name: "router/muse-spark-1.3-contributor"
    litellm_params:
      model: "openai/muse-subscription/muse-spark-1.3"
      litellm_credential_name: muse_bridge_credential
      use_chat_completions_api: true

  # Private SuperGrok subscription pins. The bridge owns native Responses
  # translation; stock LiteLLM uses Chat Completions with no PAYG fallback.
  - model_name: "supergrok/grok-4.7"
    litellm_params:
      model: "openai/supergrok/grok-4.7"
      litellm_credential_name: grok_bridge_credential
      use_chat_completions_api: true
      # A single-leg subscription route cannot fail over. Preserve the actual
      # upstream error instead of turning one transient failure into 5m of 429s.
      cooldown_time: 0
      timeout: 660
      stream_timeout: 660
    model_info:
      input_cost_per_token: 0
      output_cost_per_token: 0

credential_list:
  - credential_name: llama_swap_credential
    credential_values:
      api_base: http://llama-swap.ai-serving.svc.cluster.local:8080/v1
      api_key: none
    credential_info:
      description: "llama-swap on K8s"
  - credential_name: antigravity_credential
    credential_values:
      api_base: https://antigravity.home.shdr.ch/v1
      api_key: os.environ/ANTIGRAVITY_API_KEY
    credential_info:
      description: "Google Antigravity subscription via single-tenant bridge"
  - credential_name: muse_bridge_credential
    credential_values:
      api_base: https://muse.home.shdr.ch/v1
      api_key: os.environ/MUSE_BRIDGE_API_KEY
    credential_info:
      description: "Muse Code subscription via single-tenant bridge"
  - credential_name: grok_bridge_credential
    credential_values:
      api_base: https://grok.home.shdr.ch/v1
      api_key: os.environ/GROK_BRIDGE_API_KEY
    credential_info:
      description: "SuperGrok subscription via single-tenant Responses bridge"
  - credential_name: ollama_cloud_credential
    credential_values:
      api_base: https://ollama.com
      api_key: os.environ/OLLAMA_API_KEY
    credential_info:
      description: "Ollama Cloud"
  - credential_name: anthropic_credential
    credential_values:
      api_key: os.environ/ANTHROPIC_API_KEY
    credential_info:
      description: "Anthropic"
  - credential_name: qwen_cloud_credential
    credential_values:
      api_base: https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
      api_key: os.environ/QWEN_CLOUD_API_KEY
    credential_info:
      description: "Qwen Cloud (Alibaba MaaS)"
  - credential_name: step_credential
    credential_values:
      api_base: https://api.stepfun.ai/step_plan/v1
      api_key: os.environ/STEP_API_KEY
    credential_info:
      description: "Step Plan subscription"
  - credential_name: zai_credential
    credential_values:
      api_base: https://api.z.ai/api/coding/paas/v4
      api_key: os.environ/ZAI_API_KEY
    credential_info:
      description: "Z.AI"
  - credential_name: commandcode_credential
    credential_values:
      api_base: https://api.commandcode.ai/provider/v1
      api_key: os.environ/COMMANDCODE_API_KEY
    credential_info:
      description: "Command Code Provider API (GOAT plan)"
  - credential_name: opencode_go_credential
    credential_values:
      api_base: https://opencode.ai/zen/go/v1
      api_key: os.environ/OPENCODE_GO_API_KEY
    credential_info:
      description: "OpenCode Go"
  - credential_name: clinepass_credential
    credential_values:
      api_base: https://api.cline.bot/api/v1
      api_key: os.environ/CLINEPASS_API_KEY
    credential_info:
      description: "Clinepass (Cline API)"
  - credential_name: codebuddy_credential
    credential_values:
      api_base: https://www.codebuddy.ai/v2
      api_key: os.environ/CODEBUDDY_API_KEY
    credential_info:
      description: "Tencent CodeBuddy (international)"
  - credential_name: kimi_credential
    credential_values:
      api_base: https://api.kimi.com/coding/v1
      api_key: os.environ/KIMI_API_KEY
    credential_info:
      description: "Kimi Coding"

litellm_settings:
  drop_params: true
  turn_off_message_logging: false
  set_verbose: false
  json_logs: true
  # Per-request upstream timeout. 120s gives agentic reasoning/tool-planning
  # turns room to finish while still bounding a genuinely hung cloud provider.
  request_timeout: 120

router_settings:
  # `model_name` creates the deployment pool. Multi-leg pools use weighted
  # shuffle: the router's same-group retry that EXCLUDES the failed leg
  # (`_maybe_run_weighted_failover`) only runs under simple-shuffle, so under
  # latency routing a request that drew a quota-dead or out-of-credit leg
  # retried the same leg three times and failed (glm-5.3 via Ollama, spark
  # via clinepass, 2026-09-03). Latency routing also preferred the dead leg:
  # its error was the fastest response in the group.
  # A single failed request trips a deployment quickly; the five-minute
  # cooldown prevents repeated quota/429 traffic against low-limit providers.
  allowed_fails: 1
  cooldown_time: 300
  # Retry initial requests across the configured GLM pools when needed.
  num_retries: 3
  max_fallbacks: 3
  timeout: 120
  retry_after: 0
  debug_level: INFO
  routing_strategy: simple-shuffle
  enable_weighted_failover: true
  routing_groups:
    - group_name: router/glm-5.3-flash
      models: ["router/glm-5.3-flash"]
      routing_strategy: simple-shuffle
    - group_name: router/deepseek-v4-pro
      models: ["router/deepseek-v4-pro"]
      routing_strategy: simple-shuffle
    - group_name: router/minimax-m3
      models: ["router/minimax-m3"]
      routing_strategy: simple-shuffle
    - group_name: router/muse-spark-1.3
      models: ["router/muse-spark-1.3"]
      routing_strategy: simple-shuffle
    - group_name: router/muse-spark-1.3-contributor
      models: ["router/muse-spark-1.3-contributor"]
      routing_strategy: simple-shuffle
    # Weighted shuffle, not latency: the Ollama leg's quota error was the
    # fastest response in the group, so latency routing kept choosing it.
    - group_name: router/glm-5.3
      models: ["router/glm-5.3"]
      routing_strategy: simple-shuffle

general_settings:
  store_prompts_in_spend_logs: true
  # Raw prompts/responses make SpendLogs large (~19 GiB after 592k rows).
  # Daily aggregate tables retain cost history; bound the raw audit detail.
  maximum_spend_logs_retention_period: "7d"
  maximum_spend_logs_retention_interval: "1d"

mcp_servers:
  time:
    url: "http://localhost:8003/mcp"
  firecrawl:
    url: "http://firecrawl.firecrawl.svc.cluster.local:3007/mcp"
  # coingecko:
  #   url: "http://localhost:8002/"
  finviz:
    url: "http://localhost:8000/mcp"
  affine:
    url: "http://localhost:8005/mcp"
    auth_type: bearer_token
    auth_value: "${affine_mcp_http_token}"
  espn:
    url: "http://localhost:8080/mcp"
  tmdb:
    url: "http://localhost:8006/mcp"
  jellyfin:
    url: "http://localhost:8007/mcp"
  deskplane:
    url: "http://deskplane-mcp.deskplane.svc.cluster.local:8100/mcp"
  # Siren: 74 tools generated from its gRPC contract.
  # Cluster DNS, not mcp.siren.home.shdr.ch -- that hostname is reserved in the
  # namespace contract but has no Caddy vhost (the wildcard is single-label).
  siren:
    url: "http://siren-mcp.siren.svc.cluster.local:8082/mcp"
%{ if google_maps_enabled ~}
  google_maps:
    url: "http://localhost:8004/mcp"
%{ endif ~}
