model_list:
  # llama-swap (K8s) — AFFiNE Copilot streams via /v1/responses; bridge to chat/completions.
  - model_name: "aether/qwen3.8-27b"
    litellm_params:
      model: "openai/qwen3.8-27b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/qwen3.8-27b:code"
    litellm_params:
      model: "openai/qwen3.8-27b:code"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/qwen3.8-27b:think"
    litellm_params:
      model: "openai/qwen3.8-27b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/qwen3.6-35b-a3b"
    litellm_params:
      model: "openai/qwen3.6-35b-a3b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/qwen3.6-35b-a3b:code"
    litellm_params:
      model: "openai/qwen3.6-35b-a3b:code"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/qwen3.6-35b-a3b:think"
    litellm_params:
      model: "openai/qwen3.6-35b-a3b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/qwen3.5-9b"
    litellm_params:
      model: "openai/qwen3.5-9b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/qwen3.5-9b:think"
    litellm_params:
      model: "openai/qwen3.5-9b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/gemma-4-31b"
    litellm_params:
      model: "openai/gemma-4-31b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/gemma-4-31b:think"
    litellm_params:
      model: "openai/gemma-4-31b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/gemma-4-26b-a4b"
    litellm_params:
      model: "openai/gemma-4-26b-a4b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/gemma-4-26b-a4b:think"
    litellm_params:
      model: "openai/gemma-4-26b-a4b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/muse-glimmer-30b"
    litellm_params:
      model: "openai/muse-glimmer-30b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
  - model_name: "aether/muse-glimmer-30b:think"
    litellm_params:
      model: "openai/muse-glimmer-30b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true

  # Clinepass models (https://api.cline.bot — OpenAI-compatible).
  # GLM and Kimi entries intentionally share a model_name below so LiteLLM
  # treats every provider deployment for that family as one load-balanced
  # model group.
  - model_name: "router/deepseek-v4-pro"
    litellm_params:
      model: "openai/cline-pass/deepseek-v4-pro"
      litellm_credential_name: clinepass_credential
  - model_name: "router/deepseek-v4-flash"
    litellm_params:
      model: "openai/cline-pass/deepseek-v4-flash"
      litellm_credential_name: clinepass_credential
  - model_name: "router/kimi-k2.7-code"
    litellm_params:
      model: "openai/cline-pass/kimi-k2.7-code"
      litellm_credential_name: clinepass_credential
  - model_name: "router/glm-5.2"
    litellm_params:
      model: "openai/cline-pass/glm-5.2"
      litellm_credential_name: clinepass_credential
  - model_name: "clinepass/glm-5.3-flash"
    litellm_params:
      model: "openai/cline-pass/glm-5.3-flash"
      litellm_credential_name: clinepass_credential
  - model_name: "router/glm-5.3-flash"
    litellm_params:
      model: "openai/cline-pass/glm-5.3-flash"
      litellm_credential_name: clinepass_credential
  - model_name: "router/qwen3.7-max"
    litellm_params:
      model: "openai/cline-pass/qwen3.7-max"
      litellm_credential_name: clinepass_credential
  - model_name: "router/minimax-m3"
    litellm_params:
      model: "openai/cline-pass/minimax-m3"
      litellm_credential_name: clinepass_credential
  - model_name: "router/mimo-v2.5-pro"
    litellm_params:
      model: "openai/cline-pass/mimo-v2.5-pro"
      litellm_credential_name: clinepass_credential
  - model_name: "clinepass/hy4-preview"
    litellm_params:
      model: "openai/tencent/hy4-preview"
      litellm_credential_name: clinepass_credential
  - model_name: "router/hy4-preview"
    litellm_params:
      model: "openai/tencent/hy4-preview"
      litellm_credential_name: clinepass_credential

  # CodeBuddy's Hy4 preview endpoint is stream-only and requires a leading
  # system message. Keep it standalone so generic router traffic cannot select it.
  - model_name: "codebuddy/hy4-preview"
    litellm_params:
      model: "openai/hy4-preview"
      litellm_credential_name: codebuddy_credential
      use_chat_completions_api: true

  # Kimi Coding models (https://api.kimi.com/coding/v1 — OpenAI-compatible).
  - model_name: "kimi/k3"
    litellm_params:
      model: "openai/k3"
      litellm_credential_name: kimi_credential

  # Qwen Cloud models (https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1)
  - model_name: "qwen-cloud/qwen3.8-max"
    litellm_params:
      model: "openai/qwen3.8-max"
      litellm_credential_name: qwen_cloud_credential

  # Z.AI GLM 5.3 uses a separate router group; never mix it with GLM 5.2
  # or with GLM 5.3 Flash.
  - model_name: "router/glm-5.3"
    litellm_params:
      model: "zai/glm-5.3"
      litellm_credential_name: zai_credential
  - model_name: "zai/glm-5.3-flash"
    litellm_params:
      model: "zai/glm-5.3-flash"
      litellm_credential_name: zai_credential
  - model_name: "router/glm-5.3-flash"
    litellm_params:
      model: "zai/glm-5.3-flash"
      litellm_credential_name: zai_credential

  # Command Code models. Contributor prompts are training data — public work only.
  - model_name: "commandcode/muse-spark-1.2-contributor"
    litellm_params:
      model: "openai/meta/muse-spark-1.2-contributor"
      litellm_credential_name: commandcode_credential
  # First leg of the shuffled router/muse-spark-1.2-contributor pool.
  # commandcode/muse-spark-1.2-contributor stays standalone for callers that
  # want the GOAT route explicitly.
  - model_name: "router/muse-spark-1.2-contributor"
    litellm_params:
      model: "openai/meta/muse-spark-1.2-contributor"
      litellm_credential_name: commandcode_credential
  - model_name: "commandcode/deepseek-v4-flash"
    litellm_params:
      model: "openai/deepseek/deepseek-v4-flash"
      litellm_credential_name: commandcode_credential
  # Third leg of the shuffled router/deepseek-v4-flash pool. Pool traffic meters
  # against the GOAT allowance; commandcode/deepseek-v4-flash stays standalone
  # for callers that want the metered route explicitly.
  - model_name: "router/deepseek-v4-flash"
    litellm_params:
      model: "openai/deepseek/deepseek-v4-flash"
      litellm_credential_name: commandcode_credential
  - model_name: "commandcode/glm-5.3-flash"
    litellm_params:
      model: "openai/z-ai/glm-5.3-flash"
      litellm_credential_name: commandcode_credential
  - model_name: "router/glm-5.3-flash"
    litellm_params:
      model: "openai/z-ai/glm-5.3-flash"
      litellm_credential_name: commandcode_credential
  - model_name: "commandcode/hy4-preview"
    litellm_params:
      model: "openai/tencent/hy4-preview"
      litellm_credential_name: commandcode_credential
  - model_name: "router/hy4-preview"
    litellm_params:
      model: "openai/tencent/hy4-preview"
      litellm_credential_name: commandcode_credential

  # OpenCode Go (https://opencode.ai/zen/go/v1). Muse Spark Contributor
  # prompts are training data — public work only. Ox Alpha's free stealth
  # preview ended; the named successor is GLM 5.3 Flash.
  - model_name: "opencode-go/muse-spark-1.2-contributor"
    litellm_params:
      model: "openai/muse-spark-1.2-contributor"
      litellm_credential_name: opencode_go_credential
  - model_name: "opencode-go/glm-5.3-flash"
    litellm_params:
      model: "openai/glm-5.3-flash"
      litellm_credential_name: opencode_go_credential
  - model_name: "router/glm-5.3-flash"
    litellm_params:
      model: "openai/glm-5.3-flash"
      litellm_credential_name: opencode_go_credential
  - model_name: "opencode-go/hy4-preview"
    litellm_params:
      model: "openai/hy4-preview"
      litellm_credential_name: opencode_go_credential
  - model_name: "router/hy4-preview"
    litellm_params:
      model: "openai/hy4-preview"
      litellm_credential_name: opencode_go_credential
  # Second leg of the shuffled router/muse-spark-1.2-contributor pool.
  # opencode-go/muse-spark-1.2-contributor stays standalone for callers that
  # want the Go subscription route explicitly.
  - model_name: "router/muse-spark-1.2-contributor"
    litellm_params:
      model: "openai/muse-spark-1.2-contributor"
      litellm_credential_name: opencode_go_credential

  # Ollama Cloud models
  - model_name: "ollama-cloud/kimi-k2.6"
    litellm_params:
      model: "ollama_chat/kimi-k2.6"
      litellm_credential_name: ollama_cloud_credential
  - model_name: "router/glm-5.2"
    litellm_params:
      model: "ollama_chat/glm-5.2"
      litellm_credential_name: ollama_cloud_credential
  - model_name: "ollama-cloud/glm-5.3-flash"
    litellm_params:
      model: "ollama_chat/glm-5.3-flash"
      litellm_credential_name: ollama_cloud_credential
  - model_name: "router/glm-5.3-flash"
    litellm_params:
      model: "ollama_chat/glm-5.3-flash"
      litellm_credential_name: ollama_cloud_credential
  - model_name: "router/deepseek-v4-pro"
    litellm_params:
      model: "ollama_chat/deepseek-v4-pro:cloud"
      litellm_credential_name: ollama_cloud_credential
  - model_name: "router/deepseek-v4-flash"
    litellm_params:
      model: "ollama_chat/deepseek-v4-flash:0731"
      litellm_credential_name: ollama_cloud_credential
  # Dedicated Ollama-Cloud-only alias (Holmes/Inquest pin this; the
  # router/deepseek-v4-flash group shuffles cline-pass + Ollama Cloud + Command Code).
  - model_name: "ollama-cloud/deepseek-v4-flash"
    litellm_params:
      model: "ollama_chat/deepseek-v4-flash:0731"
      litellm_credential_name: ollama_cloud_credential
  - model_name: "ollama-cloud/gemini-3-flash-preview"
    litellm_params:
      model: "ollama_chat/gemini-3-flash-preview"
      litellm_credential_name: ollama_cloud_credential
  - model_name: "router/minimax-m3"
    litellm_params:
      model: "ollama_chat/minimax-m3"
      litellm_credential_name: ollama_cloud_credential
  - model_name: "router/kimi-k2.7-code"
    litellm_params:
      model: "ollama_chat/kimi-k2.7-code"
      litellm_credential_name: ollama_cloud_credential

  # OpenAI models — provider caches 1024+ token prefixes automatically;
  # retention + per-model cache key improve hit rate and TTL (default 5–10m → 24h).
  - model_name: "openai/gpt-5.5"
    litellm_params:
      model: "openai/gpt-5.5"
      litellm_credential_name: openai_credential
      prompt_cache_retention: "24h"
      prompt_cache_key: "openai/gpt-5.5"
  - model_name: "openai/gpt-5.4"
    litellm_params:
      model: "openai/gpt-5.4"
      litellm_credential_name: openai_credential
      prompt_cache_retention: "24h"
      prompt_cache_key: "openai/gpt-5.4"
  - model_name: "openai/gpt-5.4-mini"
    litellm_params:
      model: "openai/gpt-5.4-mini"
      litellm_credential_name: openai_credential
      prompt_cache_retention: "24h"
      prompt_cache_key: "openai/gpt-5.4-mini"
  - model_name: "openai/gpt-5.4-nano"
    litellm_params:
      model: "openai/gpt-5.4-nano"
      litellm_credential_name: openai_credential
      prompt_cache_retention: "24h"
      prompt_cache_key: "openai/gpt-5.4-nano"

  # Anthropic models — auto-inject cache_control on system messages (min 2048 tokens for 4.x).
  - model_name: "anthropic/claude-opus-4.8"
    litellm_params:
      model: "anthropic/claude-opus-4-8"
      litellm_credential_name: anthropic_credential
      cache_control_injection_points:
        - location: message
          role: system
  - model_name: "anthropic/claude-sonnet-4.6"
    litellm_params:
      model: "anthropic/claude-sonnet-4-6"
      litellm_credential_name: anthropic_credential
      cache_control_injection_points:
        - location: message
          role: system
  - model_name: "anthropic/claude-fable-5"
    litellm_params:
      model: "anthropic/claude-fable-5"
      litellm_credential_name: anthropic_credential
      cache_control_injection_points:
        - location: message
          role: system

  # Speech via llama-swap + audio.cpp (K8s)
  - model_name: "aether/qwen3-asr"
    litellm_params:
      model: "openai/qwen3-asr-0.6b"
      litellm_credential_name: llama_swap_credential
  - model_name: "aether/qwen3-tts"
    litellm_params:
      model: "openai/qwen3-tts-0.6b"
      litellm_credential_name: llama_swap_credential

  # Reranker + Embeddings via llama-swap (K8s)
  - model_name: "aether/bge-reranker-v2-m3"
    litellm_params:
      model: "openai/bge-reranker-v2-m3"
      litellm_credential_name: llama_swap_credential
  - model_name: "aether/qwen3-embedding:4b"
    litellm_params:
      model: "openai/qwen3-embedding-4b"
      litellm_credential_name: llama_swap_credential
      encoding_format: "float"
      additional_drop_params: ["dimensions"]
  - model_name: "aether/qwen3-embedding:0.6b"
    litellm_params:
      model: "openai/qwen3-embedding-0.6b"
      litellm_credential_name: llama_swap_credential
      encoding_format: "float"
      additional_drop_params: ["dimensions"]
  # AFFiNE 0.26.3 hardcodes gemini-embedding-001 for embed calls and accepts
  # text-embedding-3-large for the startup capability check (OpenAI provider builtin).
  # AFFiNE always sends dimensions=256; qwen backends ignore it — drop before LiteLLM validation.
  - model_name: "gemini-embedding-001"
    litellm_params:
      model: "openai/qwen3-embedding-0.6b"
      litellm_credential_name: llama_swap_credential
      encoding_format: "float"
      additional_drop_params: ["dimensions"]
  - model_name: "text-embedding-3-large"
    litellm_params:
      model: "openai/qwen3-embedding-0.6b"
      litellm_credential_name: llama_swap_credential
      encoding_format: "float"
      additional_drop_params: ["dimensions"]

  # Xiaomi MiMo models
  - model_name: "router/mimo-v2.5-pro"
    litellm_params:
      model: "openai/mimo-v2.5-pro"
      litellm_credential_name: xiaomi_credential

  # OpenRouter models
  - model_name: "openrouter/grok-4"
    litellm_params:
      model: "openai/x-ai/grok-4"
      litellm_credential_name: openrouter_credential
  - model_name: "openrouter/gemini-3.1-pro-preview"
    litellm_params:
      model: "openai/google/gemini-3.1-pro-preview"
      litellm_credential_name: openrouter_credential

  # Cursor model aliases via self-hosted cursorpipe (composer ns; replaced the
  # lab-built composer-api 2026-08-30 — cursorpipe exposes the full Cursor
  # model catalog, not just Composer).
  # These are the ONLY way to reach Composer from LiteLLM: no released LiteLLM
  # (checked through 1.97.0) has a native Cursor chat provider — LlmProviders.CURSOR
  # is a pass-through marker with no llms/cursor adapter, and LiteLLM's /cursor/*
  # route proxies the Cursor Cloud Agents API (api.cursor.com, Basic auth), not
  # chat completions. Do not "simplify" these to model: cursor/... — that fails
  # with LiteLLMUnknownProvider.
  # The explicit chat-completions flag lets LiteLLM bridge /responses clients to
  # the composer-api /chat/completions endpoint instead of forwarding /responses.
  - model_name: "cursor/composer-2.5"
    litellm_params:
      model: "openai/composer-2.5"
      litellm_credential_name: composer_credential
      use_chat_completions_api: true
  - model_name: "cursor/composer-2.5-fast"
    litellm_params:
      model: "openai/composer-2.5-fast"
      litellm_credential_name: composer_credential
      use_chat_completions_api: true
  - model_name: "cursor/grok-4.6"
    litellm_params:
      model: "openai/grok-4.6"
      litellm_credential_name: composer_credential
      use_chat_completions_api: true

  # Latest Gemini Flash through the single-tenant Antigravity bridge. Clients
  # own the tool loop and may select low/medium/high via reasoning_effort.
  - model_name: "antigravity/gemini-3.7-flash"
    litellm_params:
      model: "openai/antigravity/gemini-3.7-flash"
      litellm_credential_name: antigravity_credential
      use_chat_completions_api: true

credential_list:
  - credential_name: llama_swap_credential
    credential_values:
      api_base: http://llama-swap.ai-serving.svc.cluster.local:8080/v1
      api_key: none
    credential_info:
      description: "llama-swap on K8s"
  - credential_name: composer_credential
    credential_values:
      # composer runs in the `composer` ns (outside the litellm ambient mesh), so
      # cross-ns cluster DNS is unreachable from here; use the public ingress.
      api_base: https://composer.home.shdr.ch/v1
      api_key: os.environ/CURSOR_API_KEY
    credential_info:
      description: "Cursor models via self-hosted cursorpipe"
  - credential_name: antigravity_credential
    credential_values:
      api_base: https://antigravity.home.shdr.ch/v1
      api_key: os.environ/ANTIGRAVITY_API_KEY
    credential_info:
      description: "Google Antigravity subscription via single-tenant bridge"
  - credential_name: ollama_cloud_credential
    credential_values:
      api_base: https://ollama.com
      api_key: os.environ/OLLAMA_API_KEY
    credential_info:
      description: "Ollama Cloud"
  - credential_name: openai_credential
    credential_values:
      api_key: os.environ/OPENAI_API_KEY
    credential_info:
      description: "OpenAI"
  - credential_name: anthropic_credential
    credential_values:
      api_key: os.environ/ANTHROPIC_API_KEY
    credential_info:
      description: "Anthropic"
  - credential_name: openrouter_credential
    credential_values:
      api_base: https://openrouter.ai/api/v1
      api_key: os.environ/OPENROUTER_API_KEY
    credential_info:
      description: "OpenRouter"
  - credential_name: xiaomi_credential
    credential_values:
      api_base: https://token-plan-sgp.xiaomimimo.com/v1
      api_key: os.environ/XIAOMI_API_KEY
    credential_info:
      description: "Xiaomi MiMo"
  - credential_name: qwen_cloud_credential
    credential_values:
      api_base: https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
      api_key: os.environ/QWEN_CLOUD_API_KEY
    credential_info:
      description: "Qwen Cloud (Alibaba MaaS)"
  - credential_name: zai_credential
    credential_values:
      api_base: https://api.z.ai/api/coding/paas/v4
      api_key: os.environ/ZAI_API_KEY
    credential_info:
      description: "Z.AI"
  - credential_name: commandcode_credential
    credential_values:
      api_base: https://api.commandcode.ai/provider/v1
      api_key: os.environ/COMMANDCODE_API_KEY
    credential_info:
      description: "Command Code Provider API (GOAT plan)"
  - credential_name: opencode_go_credential
    credential_values:
      api_base: https://opencode.ai/zen/go/v1
      api_key: os.environ/OPENCODE_GO_API_KEY
    credential_info:
      description: "OpenCode Go"
  - credential_name: clinepass_credential
    credential_values:
      api_base: https://api.cline.bot/api/v1
      api_key: os.environ/CLINEPASS_API_KEY
    credential_info:
      description: "Clinepass (Cline API)"
  - credential_name: codebuddy_credential
    credential_values:
      api_base: https://www.codebuddy.ai/v2
      api_key: os.environ/CODEBUDDY_API_KEY
    credential_info:
      description: "Tencent CodeBuddy (international)"
  - credential_name: kimi_credential
    credential_values:
      api_base: https://api.kimi.com/coding/v1
      api_key: os.environ/KIMI_API_KEY
    credential_info:
      description: "Kimi Coding"

litellm_settings:
  drop_params: true
  turn_off_message_logging: false
  set_verbose: false
  json_logs: true
  # Per-request upstream timeout. 120s gives agentic reasoning/tool-planning
  # turns room to finish while still bounding a genuinely hung cloud provider.
  request_timeout: 120

router_settings:
  # `model_name` creates the deployment pool. Heavy multi-leg pools route by
  # measured latency; lowest_latency_buffer keeps legs within 50% of the
  # fastest in rotation so one credential's quota is not burned alone.
  # A single failed request trips a deployment quickly; the five-minute
  # cooldown prevents repeated quota/429 traffic against low-limit providers.
  allowed_fails: 1
  cooldown_time: 300
  # Retry initial requests across the configured GLM pools when needed.
  num_retries: 3
  max_fallbacks: 3
  timeout: 120
  retry_after: 0
  debug_level: INFO
  routing_strategy: simple-shuffle
  enable_weighted_failover: true
  routing_groups:
    - group_name: router/glm-5.2
      models: ["router/glm-5.2"]
      routing_strategy: simple-shuffle
    - group_name: router/glm-5.3-flash
      models: ["router/glm-5.3-flash"]
      routing_strategy: latency-based-routing
      routing_strategy_args: { ttl: 3600, lowest_latency_buffer: 0.5 }
    - group_name: router/kimi-k2.7-code
      models: ["router/kimi-k2.7-code"]
      routing_strategy: simple-shuffle
    - group_name: router/deepseek-v4-pro
      models: ["router/deepseek-v4-pro"]
      routing_strategy: latency-based-routing
      routing_strategy_args: { ttl: 3600, lowest_latency_buffer: 0.5 }
    - group_name: router/deepseek-v4-flash
      models: ["router/deepseek-v4-flash"]
      routing_strategy: latency-based-routing
      routing_strategy_args: { ttl: 3600, lowest_latency_buffer: 0.5 }
    - group_name: router/qwen3.7-max
      models: ["router/qwen3.7-max"]
      routing_strategy: simple-shuffle
    - group_name: router/minimax-m3
      models: ["router/minimax-m3"]
      routing_strategy: simple-shuffle
    - group_name: router/mimo-v2.5-pro
      models: ["router/mimo-v2.5-pro"]
      routing_strategy: simple-shuffle
    - group_name: router/muse-spark-1.2-contributor
      models: ["router/muse-spark-1.2-contributor"]
      routing_strategy: latency-based-routing
      routing_strategy_args: { ttl: 3600, lowest_latency_buffer: 0.5 }
    - group_name: router/glm-5.3
      models: ["router/glm-5.3"]
      routing_strategy: latency-based-routing
      routing_strategy_args: { ttl: 3600, lowest_latency_buffer: 0.5 }

  # Keep the old provider-prefixed names working for existing clients while
  # routing them into the new shared groups. The aliases do not duplicate
  # deployments or change the provider-specific backend model strings.
  model_group_alias:
    "glm": "router/glm-5.3"
    "kimi": "router/kimi-k2.7-code"
    "deepseek-v4-pro": "router/deepseek-v4-pro"
    "deepseek-v4-flash": "router/deepseek-v4-flash"
    "qwen3.7-max": "router/qwen3.7-max"
    "minimax-m3": "router/minimax-m3"
    "mimo-v2.5-pro": "router/mimo-v2.5-pro"
    "clinepass/glm-5.2": "router/glm-5.2"
    "zai/glm-5.3": "router/glm-5.3"
    "ollama-cloud/glm-5.3-flash:cloud": "router/glm-5.3-flash"
    "ollama-cloud/glm-5.2": "router/glm-5.2"
    "ollama-cloud/kimi-k2.7-code": "router/kimi-k2.7-code"
    "clinepass/deepseek-v4-pro": "router/deepseek-v4-pro"
    "ollama-cloud/deepseek-v4-pro:cloud": "router/deepseek-v4-pro"
    "clinepass/deepseek-v4-flash": "router/deepseek-v4-flash"
    "ollama-cloud/deepseek-v4-flash:cloud": "router/deepseek-v4-flash"
    "clinepass/qwen3.7-max": "router/qwen3.7-max"
    "clinepass/minimax-m3": "router/minimax-m3"
    "ollama-cloud/minimax-m3": "router/minimax-m3"
    "clinepass/mimo-v2.5-pro": "router/mimo-v2.5-pro"
    "xiaomi/mimo-v2.5-pro": "router/mimo-v2.5-pro"
    "muse-spark-1.2-contributor": "router/muse-spark-1.2-contributor"
    "hy4-preview": "router/hy4-preview"
    "hy4": "router/hy4-preview"

general_settings:
  store_prompts_in_spend_logs: true
  # Raw prompts/responses make SpendLogs large (~19 GiB after 592k rows).
  # Daily aggregate tables retain cost history; bound the raw audit detail.
  maximum_spend_logs_retention_period: "7d"
  maximum_spend_logs_retention_interval: "1d"

mcp_servers:
  time:
    url: "http://localhost:8003/mcp"
  firecrawl:
    url: "http://firecrawl.firecrawl.svc.cluster.local:3007/mcp"
  # coingecko:
  #   url: "http://localhost:8002/"
  finviz:
    url: "http://localhost:8000/mcp"
  affine:
    url: "http://localhost:8005/mcp"
    auth_type: bearer_token
    auth_value: "${affine_mcp_http_token}"
  espn:
    url: "http://localhost:8080/mcp"
  tmdb:
    url: "http://localhost:8006/mcp"
  jellyfin:
    url: "http://localhost:8007/mcp"
  deskplane:
    url: "http://deskplane-mcp.deskplane.svc.cluster.local:8100/mcp"
  # Siren: 74 tools generated from its gRPC contract.
  # Cluster DNS, not mcp.siren.home.shdr.ch -- that hostname is reserved in the
  # namespace contract but has no Caddy vhost (the wildcard is single-label).
  siren:
    url: "http://siren-mcp.siren.svc.cluster.local:8082/mcp"
%{ if google_maps_enabled ~}
  google_maps:
    url: "http://localhost:8004/mcp"
%{ endif ~}
