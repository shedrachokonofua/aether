# Capability metadata (model_info). /model_group/info, which omp/pi use for
# discovery, reads capabilities from LiteLLM's bundled model map. Custom
# `openai/<id>` backends are not in that map, so without model_info they
# report mode null, supports_reasoning/function_calling false, and no limits.
# LiteLLM combines a group's deployments by taking the FIRST deployment's
# mode, ANY deployment's supports_* flag, and the MAX of the token limits, so
# every leg of a router/* pool carries its own leg-accurate values.
#
# supports_forced_tool_choice: false is read by deployment_adapter
# (litellm_hooks.py), which softens a forced tool_choice to "auto" per
# attempt: MiMo V2.6 Pro answers a named forced tool_choice with a different
# tool call (2026-09-25 probe), and Step 5 Preview honoured one 1/3.
#
# reasoning_effort: `openai/` deployments do not list it as a supported
# param, so drop_params strips it unless allowed_openai_params names it.
# Clients read the same gap from /model_group/info: omp sends an effort only
# when supported_openai_params lists reasoning_effort, and LiteLLM computes
# that list from the provider, not allowed_openai_params. Every leg that
# forwards reasoning_effort therefore declares supported_openai_params (the
# provider's own list plus reasoning_effort). A group reports the list of its
# LAST deployment, so every leg declares it.
model_list:
  # llama-swap (K8s) — AFFiNE Copilot streams via /v1/responses; bridge to chat/completions.
  # Each local model is one llama-server (4 slots sharing a 262144-token KV
  # cache) with no second deployment to fail over to, so like every
  # single-deployment route it gets only the 5 s router cooldown (router_settings).
  # qwen3.8-flash-next is the pinned default; qwen3.8-27b loads on demand and
  # evicts it.
  #
  # Limits are each llama-server's --ctx-size (llama_swap.tf); every chat
  # model loads its repo's mmproj, so all read images. Output is bounded only
  # by the context. llama-swap's setParamsByID overrides the client's
  # chat_template_kwargs, so a variant's thinking mode is fixed by its ID:
  # base IDs never think, :code and :think always do. Measured on qwen3.8-27b
  # neither reasoning_effort (any level, including "none") nor a client
  # enable_thinking changes that, so these legs do not forward reasoning_effort.
  # Flash-Next pins reasoning_effort per ID in llama-swap (base: thinking off;
  # :code/:think: medium; :xhigh: opt-in, 57-84k tokens on small tasks).
  - model_name: "aether/qwen3.8-flash-next"
    litellm_params:
      model: "openai/qwen3.8-flash-next"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: false, supports_vision: true}
  - model_name: "aether/qwen3.8-flash-next:code"
    litellm_params:
      model: "openai/qwen3.8-flash-next:code"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "aether/qwen3.8-flash-next:think"
    litellm_params:
      model: "openai/qwen3.8-flash-next:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "aether/qwen3.8-flash-next:xhigh"
    litellm_params:
      model: "openai/qwen3.8-flash-next:xhigh"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "aether/qwen3.8-27b"
    litellm_params:
      model: "openai/qwen3.8-27b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: false, supports_vision: true}
  - model_name: "aether/qwen3.8-27b:code"
    litellm_params:
      model: "openai/qwen3.8-27b:code"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "aether/qwen3.8-27b:think"
    litellm_params:
      model: "openai/qwen3.8-27b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "aether/qwen3.6-35b-a3b"
    litellm_params:
      model: "openai/qwen3.6-35b-a3b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: false, supports_vision: true}
  - model_name: "aether/qwen3.6-35b-a3b:code"
    litellm_params:
      model: "openai/qwen3.6-35b-a3b:code"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "aether/qwen3.6-35b-a3b:think"
    litellm_params:
      model: "openai/qwen3.6-35b-a3b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "aether/qwen3.5-9b"
    litellm_params:
      model: "openai/qwen3.5-9b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 131072, supports_function_calling: true, supports_reasoning: false, supports_vision: true}
  - model_name: "aether/qwen3.5-9b:think"
    litellm_params:
      model: "openai/qwen3.5-9b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "aether/gemma-4-31b"
    litellm_params:
      model: "openai/gemma-4-31b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: false, supports_vision: true}
  - model_name: "aether/gemma-4-31b:think"
    litellm_params:
      model: "openai/gemma-4-31b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "aether/gemma-4-26b-a4b"
    litellm_params:
      model: "openai/gemma-4-26b-a4b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: false, supports_vision: true}
  - model_name: "aether/gemma-4-26b-a4b:think"
    litellm_params:
      model: "openai/gemma-4-26b-a4b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 262144, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  # Glimmer thinks via chat_template_kwargs.reasoning_effort, which only the
  # :think ID sets; b10423 does not map the top-level field onto it.
  - model_name: "aether/muse-glimmer-30b"
    litellm_params:
      model: "openai/muse-glimmer-30b"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 131072, supports_function_calling: true, supports_reasoning: false, supports_vision: true}
  - model_name: "aether/muse-glimmer-30b:think"
    litellm_params:
      model: "openai/muse-glimmer-30b:think"
      litellm_credential_name: llama_swap_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true}

  # Clinepass models (https://api.cline.bot — OpenAI-compatible).
  # Cline legs are pins only (clinepass/*), not router members: Cline's
  # balance went negative and answered 402 on every draw (2026-09-03);
  # LiteLLM does not retry a 402 within the group, so one dead leg failed a
  # third of first requests. Re-add router/* legs when funded.
  # Limits: models.dev `cline-pass` where listed; Muse Spark 1.3 and Hy4 use
  # the model's published limits.
  - model_name: "clinepass/glm-5.3-flash"
    litellm_params:
      model: "openai/cline-pass/glm-5.3-flash"
      litellm_credential_name: clinepass_credential
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1000000, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: &openai_reasoning_params [frequency_penalty, logit_bias, logprobs, top_logprobs, max_tokens, max_completion_tokens, modalities, prediction, n, presence_penalty, seed, stop, stream, stream_options, temperature, top_p, tools, tool_choice, function_call, functions, max_retries, extra_headers, parallel_tool_calls, audio, web_search_options, service_tier, safety_identifier, prompt_cache_key, prompt_cache_retention, store, response_format, reasoning_effort]}
  - model_name: "clinepass/qwen3.8-max"
    litellm_params:
      model: "openai/cline-pass/qwen3.8-max"
      litellm_credential_name: clinepass_credential
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1000000, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "clinepass/muse-spark-1.3"
    litellm_params:
      model: "openai/meta/muse-spark-1.3"
      litellm_credential_name: clinepass_credential
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "clinepass/muse-spark-1.3-contributor"
    litellm_params:
      model: "openai/meta/muse-spark-1.3-contributor"
      litellm_credential_name: clinepass_credential
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "clinepass/hy4-preview"
    litellm_params:
      model: "openai/tencent/hy4-preview"
      litellm_credential_name: clinepass_credential
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1024000, max_output_tokens: 64000, supports_function_calling: true, supports_reasoning: true, supports_vision: false, supported_openai_params: *openai_reasoning_params}

  # CodeBuddy's Hy4 preview endpoint is stream-only (Moira's codebuddy rule
  # sets chat_requires_stream) and requires a leading system message
  # (deployment_adapter prepends an empty one via the model_info flag).
  # Limits are Tencent's published Hy4 limits; CodeBuddy publishes none.
  - model_name: "codebuddy/hy4-preview"
    litellm_params:
      model: "openai/hy4-preview"
      litellm_credential_name: codebuddy_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1024000, max_output_tokens: 64000, supports_function_calling: true, supports_reasoning: true, supports_vision: false, requires_leading_system_message: true, supported_openai_params: *openai_reasoning_params}

  # Kimi Coding models (https://api.kimi.com/coding/v1 — OpenAI-compatible).
  # Context and image input from the endpoint's /models; K3 always thinks
  # (supports_thinking_type "only") and takes low/high/max effort.
  - model_name: "kimi/k3"
    litellm_params:
      model: "openai/k3"
      litellm_credential_name: kimi_credential
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}

  # Qwen Cloud models (https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1)
  # Limits: models.dev `alibaba-token-plan`.
  - model_name: "qwen-cloud/qwen3.8-max"
    litellm_params:
      model: "openai/qwen3.8-max"
      litellm_credential_name: qwen_cloud_credential
      allowed_openai_params: ["reasoning_effort"]
      # Agent contexts of ~450k tokens can go longer than the global 120 s
      # without a byte: 33 timeouts in 24 h (2026-10-10) while successes ran up
      # to 273 s, and each timeout cooled the only deployment for 5 s. Match
      # Muse/Grok.
      timeout: 900
      stream_timeout: 900
    model_info: {mode: chat, max_input_tokens: 1000000, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "qwen-cloud/qwen3.8-flash"
    litellm_params:
      model: "openai/qwen3.8-flash"
      litellm_credential_name: qwen_cloud_credential
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1000000, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}

  # Step Plan subscription — no PAYG fallback.
  # Input limit, vision and reasoning from the endpoint's /models.
  - model_name: "step/step-5-preview"
    litellm_params:
      model: "openai/step-5-preview"
      litellm_credential_name: step_credential
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1024000, max_output_tokens: 65536, supports_forced_tool_choice: false, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}

  # GLM 5.3 and GLM 5.3 Flash stay in separate model pools.
  # `zai/` is a native LiteLLM provider: its bundled model map already
  # supplies accurate capabilities and limits, so these legs set no model_info.
  - model_name: "router/glm-5.3"
    litellm_params:
      cooldown_time: 300
      model: "zai/glm-5.3"
      litellm_credential_name: zai_credential
      weight: 4
  # Standalone pin for Moira: the router legs above/below are copied verbatim
  # so every leg of a Moira-ranked router group is individually addressable.
  - model_name: "zai/glm-5.3"
    litellm_params:
      model: "zai/glm-5.3"
      litellm_credential_name: zai_credential
      weight: 4
  - model_name: "zai/glm-5.3-flash"
    litellm_params:
      model: "zai/glm-5.3-flash"
      litellm_credential_name: zai_credential
  - model_name: "router/glm-5.3-flash"
    litellm_params:
      cooldown_time: 300
      model: "zai/glm-5.3-flash"
      litellm_credential_name: zai_credential

  # Command Code Muse models, including the separate Contributor route.
  # Context from the endpoint's /models (1048576 for every model here); output
  # limits and modalities are each model's published values. reasoning_effort
  # stays dropped: the plan's weekly limit blocked testing it (resets
  # 2026-10-01), and every model here reasons by default.
  # use_chat_completions_api: /v1/responses callers are bridged to Chat
  # Completions. Without it LiteLLM calls Command Code's native /responses,
  # which answered ModelProtocolUnsupported for MiMo (2026-09-27) and which
  # its /models does not list for Hy4.
  - model_name: "commandcode/muse-spark-1.3"
    litellm_params:
      model: "openai/meta/muse-spark-1.3"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "router/muse-spark-1.3"
    litellm_params:
      cooldown_time: 300
      model: "openai/meta/muse-spark-1.3"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
      order: 2
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "commandcode/muse-spark-1.3-contributor"
    litellm_params:
      model: "openai/meta/muse-spark-1.3-contributor"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "router/muse-spark-1.3-contributor"
    litellm_params:
      cooldown_time: 300
      model: "openai/meta/muse-spark-1.3-contributor"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
      order: 2
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "commandcode/glm-5.3-flash"
    litellm_params:
      model: "openai/z-ai/glm-5.3-flash"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "router/glm-5.3-flash"
    litellm_params:
      cooldown_time: 300
      model: "openai/z-ai/glm-5.3-flash"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "commandcode/hy4-preview"
    litellm_params:
      model: "openai/tencent/hy4-preview"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 64000, supports_function_calling: true, supports_reasoning: true, supports_vision: false}
  - model_name: "router/hy4-preview"
    litellm_params:
      cooldown_time: 300
      model: "openai/tencent/hy4-preview"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 64000, supports_function_calling: true, supports_reasoning: true, supports_vision: false}
  - model_name: "commandcode/mimo-v2.6-pro"
    litellm_params:
      model: "openai/xiaomi/mimo-v2.6-pro"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_forced_tool_choice: false, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "router/mimo-v2.6-pro"
    litellm_params:
      cooldown_time: 300
      model: "openai/xiaomi/mimo-v2.6-pro"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
      order: 2
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_forced_tool_choice: false, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "commandcode/mimo-v2.6-flash"
    litellm_params:
      model: "openai/xiaomi/mimo-v2.6-flash"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true}
  - model_name: "router/mimo-v2.6-flash"
    litellm_params:
      cooldown_time: 300
      model: "openai/xiaomi/mimo-v2.6-flash"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
      order: 2
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true}

  # Ling 3.1 Flash (inclusionAI; AA Intelligence 41 -> moira/flash), free on
  # two routes. Command Code's `:free` variant does not draw on the GOAT plan's
  # weekly window but its upstream 429s intermittently (3/5 on 2026-10-06), so
  # it backs the OpenRouter leg. The `commandcode-free/` prefix keeps it out of
  # Moira's `commandcode` quota (tiers.yaml).
  - model_name: "commandcode-free/ling-3.1-flash"
    litellm_params:
      model: "openai/inclusionai/ling-3.1-flash:free"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 262144, max_output_tokens: 32768, supports_function_calling: true, supports_reasoning: true, supports_vision: false, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/ling-3.1-flash"
    litellm_params:
      cooldown_time: 300
      model: "openai/inclusionai/ling-3.1-flash:free"
      litellm_credential_name: commandcode_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
      order: 2
    model_info: {mode: chat, max_input_tokens: 262144, max_output_tokens: 32768, supports_function_calling: true, supports_reasoning: true, supports_vision: false, supported_openai_params: *openai_reasoning_params}
  # OpenRouter: the ONLY OpenRouter route, and $0-only. provider.max_price 0
  # makes OpenRouter refuse the request rather than bill if the free price
  # ends; allow_fallbacks false keeps it off any paid alternate provider.
  - model_name: "openrouter/ling-3.1-flash"
    litellm_params:
      model: "openrouter/inclusionai/ling-3.1-flash"
      litellm_credential_name: openrouter_credential
      allowed_openai_params: ["reasoning_effort"]
      extra_body: &openrouter_free_only
        provider: {max_price: {prompt: 0, completion: 0}, allow_fallbacks: false}
    model_info: {mode: chat, max_input_tokens: 262144, max_output_tokens: 32768, supports_function_calling: true, supports_reasoning: true, supports_vision: false, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/ling-3.1-flash"
    litellm_params:
      cooldown_time: 300
      model: "openrouter/inclusionai/ling-3.1-flash"
      litellm_credential_name: openrouter_credential
      allowed_openai_params: ["reasoning_effort"]
      extra_body: *openrouter_free_only
      order: 1
    model_info: {mode: chat, max_input_tokens: 262144, max_output_tokens: 32768, supports_function_calling: true, supports_reasoning: true, supports_vision: false, supported_openai_params: *openai_reasoning_params}

  # OpenCode Go (https://opencode.ai/zen/go/v1).
  # Go rejects requests without x-opencode-session (MissingSessionID) and asks
  # clients to identify with their own User-Agent. LiteLLM sends one static
  # session for all gateway traffic; clients do not pass a per-conversation ID.
  # Muse Spark Contributor is not routed through Go: its endpoint answered
  # "Endpoint is unavailable" (region-limited per OpenCode's docs, 2026-09-25).
  # Limits: models.dev `opencode-go`.
  # use_chat_completions_api: Go answers ModelProtocolUnsupported on native
  # /responses for every model here (2026-09-27). Unbridged, a /v1/responses
  # caller of a router/* pool failed outright whenever the pool fell back to
  # a Go leg (router/mimo-v2.6-pro, 2026-09-27 14:28-14:33).
  - model_name: "opencode-go/glm-5.3-flash"
    litellm_params:
      model: "openai/glm-5.3-flash"
      litellm_credential_name: opencode_go_credential
      use_chat_completions_api: true
      extra_headers: &opencode_go_headers
        x-opencode-session: "aether-litellm"
        User-Agent: "aether-litellm/1.0"
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1000000, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/glm-5.3-flash"
    litellm_params:
      cooldown_time: 300
      model: "openai/glm-5.3-flash"
      litellm_credential_name: opencode_go_credential
      use_chat_completions_api: true
      extra_headers: *opencode_go_headers
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1000000, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "opencode-go/hy4-preview"
    litellm_params:
      model: "openai/hy4-preview"
      litellm_credential_name: opencode_go_credential
      use_chat_completions_api: true
      extra_headers: *opencode_go_headers
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1024000, max_output_tokens: 64000, supports_function_calling: true, supports_reasoning: true, supports_vision: false, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/hy4-preview"
    litellm_params:
      cooldown_time: 300
      model: "openai/hy4-preview"
      litellm_credential_name: opencode_go_credential
      use_chat_completions_api: true
      extra_headers: *opencode_go_headers
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1024000, max_output_tokens: 64000, supports_function_calling: true, supports_reasoning: true, supports_vision: false, supported_openai_params: *openai_reasoning_params}
  - model_name: "opencode-go/mimo-v2.6-pro"
    litellm_params:
      model: "openai/mimo-v2.6-pro"
      litellm_credential_name: opencode_go_credential
      use_chat_completions_api: true
      extra_headers: *opencode_go_headers
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_forced_tool_choice: false, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/mimo-v2.6-pro"
    litellm_params:
      cooldown_time: 300
      model: "openai/mimo-v2.6-pro"
      litellm_credential_name: opencode_go_credential
      use_chat_completions_api: true
      extra_headers: *opencode_go_headers
      allowed_openai_params: ["reasoning_effort"]
      order: 2
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_forced_tool_choice: false, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "opencode-go/mimo-v2.6-flash"
    litellm_params:
      model: "openai/mimo-v2.6-flash"
      litellm_credential_name: opencode_go_credential
      use_chat_completions_api: true
      extra_headers: *opencode_go_headers
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/mimo-v2.6-flash"
    litellm_params:
      cooldown_time: 300
      model: "openai/mimo-v2.6-flash"
      litellm_credential_name: opencode_go_credential
      use_chat_completions_api: true
      extra_headers: *opencode_go_headers
      allowed_openai_params: ["reasoning_effort"]
      order: 2
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}

  # Xiaomi MiMo token plan (https://token-plan-sgp.xiaomimimo.com/v1).
  # Priority leg of the router/mimo-* pools: order 1 takes every request while
  # healthy; the CommandCode and OpenCode Go legs (order 2) serve only while
  # Xiaomi is failing or cooling down. ClinePass also lists MiMo 2.6 but is not
  # wired while its balance is negative.
  # Limits: models.dev `xiaomi-token-plan-sgp`.
  - model_name: "xiaomi/mimo-v2.6-pro"
    litellm_params:
      model: "openai/mimo-v2.6-pro"
      litellm_credential_name: xiaomi_credential
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_forced_tool_choice: false, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/mimo-v2.6-pro"
    litellm_params:
      cooldown_time: 300
      model: "openai/mimo-v2.6-pro"
      litellm_credential_name: xiaomi_credential
      allowed_openai_params: ["reasoning_effort"]
      order: 1
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_forced_tool_choice: false, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "xiaomi/mimo-v2.6-flash"
    litellm_params:
      model: "openai/mimo-v2.6-flash"
      litellm_credential_name: xiaomi_credential
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/mimo-v2.6-flash"
    litellm_params:
      cooldown_time: 300
      model: "openai/mimo-v2.6-flash"
      litellm_credential_name: xiaomi_credential
      allowed_openai_params: ["reasoning_effort"]
      order: 1
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}

  # Ollama Cloud models. Context and capabilities (tools/thinking/vision)
  # from Ollama's /api/show; output limits from models.dev `ollama-cloud`.
  # Served through Ollama's OpenAI-compatible /v1 endpoint, not LiteLLM's
  # `ollama_chat` adapter: that adapter merged parallel tool calls into one
  # call with concatenated JSON arguments ("Extra data"; moira/strong ->
  # ollama-cloud/glm-5.3, 2026-10-03). /v1 returns them separately, streamed
  # and not (probe 2026-10-07). /v1 ids drop the `:cloud` tag.
  - model_name: "ollama-cloud/glm-5.3-flash"
    litellm_params:
      model: "openai/glm-5.3-flash"
      litellm_credential_name: ollama_cloud_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
    model_info: {unique_response_ids: false, mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/glm-5.3-flash"
    litellm_params:
      cooldown_time: 300
      model: "openai/glm-5.3-flash"
      litellm_credential_name: ollama_cloud_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
    model_info: {unique_response_ids: false, mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/glm-5.3"
    litellm_params:
      cooldown_time: 300
      model: "openai/glm-5.3"
      litellm_credential_name: ollama_cloud_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
      weight: 1
    model_info: {unique_response_ids: false, mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: false, supported_openai_params: *openai_reasoning_params}
  # Standalone pin for Moira (see the zai/glm-5.3 note above).
  - model_name: "ollama-cloud/glm-5.3"
    litellm_params:
      model: "openai/glm-5.3"
      litellm_credential_name: ollama_cloud_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
      weight: 1
    model_info: {unique_response_ids: false, mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: false, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/deepseek-v4-pro"
    litellm_params:
      model: "openai/deepseek-v4-pro:0813"
      litellm_credential_name: ollama_cloud_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
    model_info: {unique_response_ids: false, mode: chat, max_input_tokens: 1048576, supports_function_calling: true, supports_reasoning: true, supports_vision: false, supported_openai_params: *openai_reasoning_params}
  # Standalone pin for Moira (see the zai/glm-5.3 note above).
  - model_name: "ollama-cloud/deepseek-v4-pro"
    litellm_params:
      model: "openai/deepseek-v4-pro:0813"
      litellm_credential_name: ollama_cloud_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
    model_info: {unique_response_ids: false, mode: chat, max_input_tokens: 1048576, supports_function_calling: true, supports_reasoning: true, supports_vision: false, supported_openai_params: *openai_reasoning_params}
  # MiniMax M3 stays on LiteLLM's native ollama_chat adapter: Ollama's /v1
  # streams its parallel tool calls all at `index: 0` (distinct ids), which
  # OpenAI clients merge into one call (probe 2026-10-07, 3/3). ollama_chat
  # returned them separately. api_base overrides the credential's /v1 base.
  - model_name: "router/minimax-m3"
    litellm_params:
      model: "ollama_chat/minimax-m3"
      litellm_credential_name: ollama_cloud_credential
      api_base: https://ollama.com
    model_info: {unique_response_ids: false, mode: chat, max_input_tokens: 512000, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: [max_tokens, max_completion_tokens, stream, top_p, temperature, seed, frequency_penalty, stop, tools, tool_choice, functions, response_format, reasoning_effort]}

  # ChatGPT subscription OAuth — native Responses API; no PAYG fallback.
  # GPT-6 is not in LiteLLM's bundled catalog yet; declare native streaming.
  # Input limit is the Codex backend's context_window for these slugs
  # (/backend-api/codex/models; max_context_window is 872000). Output limit
  # is OpenAI's published GPT-6 value. The chatgpt provider does not list
  # reasoning_effort either; without the allow-list "low" still spent the
  # default ~50 reasoning tokens, with it 0 (2026-09-27). The backend returns
  # reasoning text only when a summary is requested, e.g.
  # reasoning_effort: {effort: high, summary: auto}.
  - model_name: "chatgpt/gpt-6-astra"
    litellm_params:
      model: "chatgpt/gpt-6-astra"
      allowed_openai_params: ["reasoning_effort"]
    model_info: {system_as_string: true, mode: responses, supports_native_streaming: true, max_input_tokens: 272000, max_output_tokens: 128000, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: &chatgpt_reasoning_params [frequency_penalty, logit_bias, logprobs, top_logprobs, max_tokens, max_completion_tokens, modalities, prediction, n, presence_penalty, seed, stop, stream, stream_options, temperature, top_p, tools, tool_choice, function_call, functions, max_retries, extra_headers, parallel_tool_calls, audio, web_search_options, service_tier, safety_identifier, prompt_cache_key, prompt_cache_retention, store, response_format, reasoning_effort, user]}
  # GPT-6.1 Sol replaced GPT-6 Sol (2026-09-29). It rejects reasoning_effort
  # none/minimal, unlike the GPT-6 slugs.
  - model_name: "chatgpt/gpt-6.1-sol"
    litellm_params:
      model: "chatgpt/gpt-6.1-sol"
      allowed_openai_params: ["reasoning_effort"]
    model_info: {system_as_string: true, mode: responses, supports_native_streaming: true, max_input_tokens: 272000, max_output_tokens: 128000, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *chatgpt_reasoning_params}
  - model_name: "chatgpt/gpt-6-luna"
    litellm_params:
      model: "chatgpt/gpt-6-luna"
      allowed_openai_params: ["reasoning_effort"]
    model_info: {system_as_string: true, mode: responses, supports_native_streaming: true, max_input_tokens: 272000, max_output_tokens: 128000, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *chatgpt_reasoning_params}

  # Household pool: OpenWebUI's single family model. Priority order, not a
  # shuffle: GPT-6 Astra while the ChatGPT plan has quota (the plan's weekly
  # limit was exhausted on 2026-09-25 by other keys), then Muse Spark 1.3 on
  # both its legs, then MiMo V2.6 Pro on the Xiaomi token plan. Picked from
  # the family's own prompts: study/homework, writing, and health questions,
  # 8% needing images and 13% documents, so every leg reads images.
  #
  # Muse reasons privately for up to ~50 s before its first token, and Meta
  # redacts that reasoning on Chat Completions. Its family legs therefore use
  # the Responses API (openai/responses/) and request a reasoning summary,
  # which LiteLLM streams as reasoning_content for OpenWebUI's thinking block.
  # The dict is forwarded verbatim as Responses `reasoning`; it must be
  # allow-listed or drop_params removes it. Native streaming must be declared
  # or LiteLLM buffers the whole reply and the summary arrives with the text.
  #
  # LiteLLM reports the pool's max_input_tokens as its largest leg (1048576),
  # although the order-1 Astra leg accepts 272000.
  - model_name: "router/family"
    litellm_params:
      cooldown_time: 300
      model: "chatgpt/gpt-6-astra"
      allowed_openai_params: ["reasoning_effort"]
      order: 1
    model_info: {mode: responses, supports_native_streaming: true, max_input_tokens: 272000, max_output_tokens: 128000, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *chatgpt_reasoning_params}
  - model_name: "router/family"
    litellm_params:
      cooldown_time: 300
      model: "openai/responses/muse-subscription/muse-spark-1.3"
      litellm_credential_name: muse_bridge_credential
      reasoning_effort: &muse_summary {summary: concise}
      allowed_openai_params: ["reasoning_effort"]
      order: 2
    model_info: {mode: responses, supports_native_streaming: true, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/family"
    litellm_params:
      cooldown_time: 300
      model: "openai/responses/meta/muse-spark-1.3"
      litellm_credential_name: commandcode_credential
      reasoning_effort: *muse_summary
      allowed_openai_params: ["reasoning_effort"]
      order: 2
    model_info: {mode: responses, supports_native_streaming: true, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/family"
    litellm_params:
      cooldown_time: 300
      model: "openai/mimo-v2.6-pro"
      litellm_credential_name: xiaomi_credential
      allowed_openai_params: ["reasoning_effort"]
      order: 3
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_forced_tool_choice: false, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}

  # Speech via llama-swap + audio.cpp (K8s)
  - model_name: "aether/qwen3-asr"
    litellm_params:
      model: "openai/qwen3-asr-0.6b"
      litellm_credential_name: llama_swap_credential
    model_info: {mode: audio_transcription}
  - model_name: "aether/qwen3-tts"
    litellm_params:
      model: "openai/qwen3-tts-0.6b"
      litellm_credential_name: llama_swap_credential
    model_info: {mode: audio_speech}

  # Reranker + Embeddings via llama-swap (K8s)
  - model_name: "aether/bge-reranker-v2-m3"
    litellm_params:
      model: "openai/bge-reranker-v2-m3"
      litellm_credential_name: llama_swap_credential
    model_info: {mode: rerank}
  - model_name: "aether/qwen3-embedding:4b"
    litellm_params:
      model: "openai/qwen3-embedding-4b"
      litellm_credential_name: llama_swap_credential
      encoding_format: "float"
      additional_drop_params: ["dimensions"]
    model_info: {mode: embedding}
  - model_name: "aether/qwen3-embedding:0.6b"
    litellm_params:
      model: "openai/qwen3-embedding-0.6b"
      litellm_credential_name: llama_swap_credential
      encoding_format: "float"
      additional_drop_params: ["dimensions"]
    model_info: {mode: embedding}
  # AFFiNE 0.26.3 hardcodes gemini-embedding-001 for embed calls and accepts
  # text-embedding-3-large for the startup capability check (OpenAI provider builtin).
  # AFFiNE always sends dimensions=256; qwen backends ignore it — drop before LiteLLM validation.
  - model_name: "gemini-embedding-001"
    litellm_params:
      model: "openai/qwen3-embedding-0.6b"
      litellm_credential_name: llama_swap_credential
      encoding_format: "float"
      additional_drop_params: ["dimensions"]
    model_info: {mode: embedding}
  - model_name: "text-embedding-3-large"
    litellm_params:
      model: "openai/qwen3-embedding-0.6b"
      litellm_credential_name: llama_swap_credential
      encoding_format: "float"
      additional_drop_params: ["dimensions"]
    model_info: {mode: embedding}


  # Gemini Flash models through the single-tenant Antigravity bridge. Clients
  # own the tool loop and may select none/minimal/low/medium/high/xhigh via
  # reasoning_effort ("none" selects the thinking-off route). Limits and image
  # input come from the bridge's pi-antigravity model table.
  - model_name: "antigravity/gemini-3.8-flash"
    litellm_params:
      model: "openai/antigravity/gemini-3.8-flash"
      litellm_credential_name: antigravity_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 65536, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}

  # Private Muse Code subscription bridge. This deployment never falls back to PAYG.
  # The bridge relays reasoning_effort to Meta (minimal..max) and raises
  # "none", which Meta rejects, to "minimal". Meta redacts reasoning text on
  # Chat Completions.
  - model_name: "meta/muse-spark-1.3"
    litellm_params:
      model: "openai/muse-subscription/muse-spark-1.3"
      litellm_credential_name: muse_bridge_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
      # Muse reasons silently on large agent contexts: the global 120 s cut
      # aborted in-progress turns (0 bytes relayed) and the timeout then
      # cooled the subscription (col-a06fd636, 2026-09-28). Match Grok.
      timeout: 900
      stream_timeout: 900
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  - model_name: "router/muse-spark-1.3"
    litellm_params:
      cooldown_time: 300
      model: "openai/muse-subscription/muse-spark-1.3"
      litellm_credential_name: muse_bridge_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
      timeout: 900
      stream_timeout: 900
      # Priority leg: takes every request while healthy; Command Code (order 2)
      # serves only while the subscription is failing or cooling down.
      order: 1
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}

  # The subscription key is also entitled to Meta's Contributor tier, drawing
  # on the same subscription quota at a fraction of Standard's token price.
  - model_name: "router/muse-spark-1.3-contributor"
    litellm_params:
      cooldown_time: 300
      model: "openai/muse-subscription/muse-spark-1.3-contributor"
      litellm_credential_name: muse_bridge_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
      timeout: 900
      stream_timeout: 900
      order: 1
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  # Standalone pin of the Contributor leg so Moira can route to it directly.
  - model_name: "meta/muse-spark-1.3-contributor"
    litellm_params:
      model: "openai/muse-subscription/muse-spark-1.3-contributor"
      litellm_credential_name: muse_bridge_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
      timeout: 900
      stream_timeout: 900
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}

  # Private SuperGrok subscription pins. The bridge owns native Responses
  # translation; stock LiteLLM uses Chat Completions with no PAYG fallback.
  # The bridge maps reasoning_effort onto Responses `reasoning.effort` and
  # accepts image_url parts and function tools. Input limit is xAI's
  # published Grok 4.7 context; no separate output cap is published.
  - model_name: "supergrok/grok-4.7"
    litellm_params:
      model: "openai/supergrok/grok-4.7"
      litellm_credential_name: grok_bridge_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
      timeout: 900
      stream_timeout: 900
    model_info:
      input_cost_per_token: 0
      output_cost_per_token: 0
      mode: chat
      max_input_tokens: 500000
      supports_function_calling: true
      supports_reasoning: true
      supports_vision: true
      supported_openai_params: *openai_reasoning_params

  # Private Claude subscription pins. The bridge speaks native Anthropic
  # Messages through its pi-ai core; LiteLLM's anthropic provider owns
  # caller-side Chat Completions translation. No PAYG fallback; the bridge
  # fails closed if Anthropic classifies traffic as third-party extra usage.
  # No allowed_openai_params: passing reasoning_effort through verbatim reached
  # the bridge as an unknown Messages field (400 "unsupported request field:
  # reasoning_effort"); LiteLLM's anthropic adapter maps effort to thinking.
  - model_name: "claude/sonnet-5-5"
    litellm_params:
      model: "anthropic/claude-sonnet-5-5"
      litellm_credential_name: claude_bridge_credential
      timeout: 900
      stream_timeout: 900
    model_info:
      input_cost_per_token: 0
      output_cost_per_token: 0
      mode: chat
      max_input_tokens: 1000000
      max_output_tokens: 128000
      supports_function_calling: true
      supports_reasoning: true
      supports_vision: true
      supported_openai_params: *openai_reasoning_params
  - model_name: "claude/opus-5-5"
    litellm_params:
      model: "anthropic/claude-opus-5-5"
      litellm_credential_name: claude_bridge_credential
      timeout: 900
      stream_timeout: 900
    model_info:
      input_cost_per_token: 0
      output_cost_per_token: 0
      mode: chat
      max_input_tokens: 1000000
      max_output_tokens: 128000
      supports_function_calling: true
      supports_reasoning: true
      supports_vision: true
      supported_openai_params: *openai_reasoning_params
  # Haiku 5.5 (2026-10-07): moira/flash at high/xhigh (AA 37.8 / 41.2).
  - model_name: "claude/haiku-5-5"
    litellm_params:
      model: "anthropic/claude-haiku-5-5"
      litellm_credential_name: claude_bridge_credential
      timeout: 900
      stream_timeout: 900
    model_info:
      input_cost_per_token: 0
      output_cost_per_token: 0
      mode: chat
      max_input_tokens: 1000000
      max_output_tokens: 128000
      supports_function_calling: true
      supports_reasoning: true
      supports_vision: true
      supported_openai_params: *openai_reasoning_params
  - model_name: "claude/fable-5-1"
    litellm_params:
      model: "anthropic/claude-fable-5-1"
      litellm_credential_name: claude_bridge_credential
      timeout: 900
      stream_timeout: 900
    model_info:
      input_cost_per_token: 0
      output_cost_per_token: 0
      mode: chat
      max_input_tokens: 1000000
      max_output_tokens: 128000
      supports_function_calling: true
      supports_reasoning: true
      supports_vision: true
      supported_openai_params: *openai_reasoning_params

  # Moira tier aliases. Each copies the exact litellm_params + model_info of
  # its tier's default model (muse-spark-1.3-contributor / k3 / glm-5.3-flash)
  # and is a real deployment: it serves the static default when the
  # moira_router hook leaves a moira/<tier> request unchanged (Moira
  # passthrough or down). Moira never routes to Standard Muse, only Contributor.
  - model_name: "moira/frontier"
    litellm_params:
      model: "openai/muse-subscription/muse-spark-1.3-contributor"
      litellm_credential_name: muse_bridge_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
      # Muse reasons silently on large agent contexts: the global 120 s cut
      # aborted in-progress turns (0 bytes relayed) and the timeout then
      # cooled the subscription (col-a06fd636, 2026-09-28). Match Grok.
      timeout: 900
      stream_timeout: 900
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  # Fail-open default when Moira is unreachable: Muse Contributor, the largest
  # strong pool (~1.5B tokens/week). Kimi (the old default) has the smallest
  # pool and was serving these while exhausted (2026-10-08).
  - model_name: "moira/strong"
    litellm_params:
      model: "openai/muse-subscription/muse-spark-1.3-contributor"
      litellm_credential_name: muse_bridge_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
      timeout: 900
      stream_timeout: 900
    model_info: {mode: chat, max_input_tokens: 1048576, max_output_tokens: 131072, supports_function_calling: true, supports_reasoning: true, supports_vision: true, supported_openai_params: *openai_reasoning_params}
  # Fail-open defaults for flash and cyber: GLM-5.3 Flash on Ollama Cloud
  # (/v1). Z.AI's Lite plan has the smaller 5h window, so the default that
  # runs unmetered (Moira unreachable) stays off it.
  - model_name: "moira/flash"
    litellm_params:
      model: "openai/glm-5.3-flash"
      litellm_credential_name: ollama_cloud_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
    model_info: {unique_response_ids: false}
  # Defensive security work, ranked by the AA Cyber Index with zero refusals
  # (moira/tiers.yaml `cyber`). Fail-open default: GLM-5.3 Flash (49.9, 0%).
  - model_name: "moira/cyber"
    litellm_params:
      model: "openai/glm-5.3-flash"
      litellm_credential_name: ollama_cloud_credential
      use_chat_completions_api: true
      allowed_openai_params: ["reasoning_effort"]
    model_info: {unique_response_ids: false}

