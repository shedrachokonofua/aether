litellm_settings:
  drop_params: true
  # litellm_hooks.py (mounted as /app/aether_hooks.py):
  # - chat_reasoning_effort flattens the Responses `reasoning` object that
  #   LiteLLM copies into reasoning_effort when it bridges /v1/responses onto
  #   Chat Completions backends.
  # - moira_router asks Moira's POST /decide which concrete model a
  #   moira/<tier> or router/* request should use, rewriting the request (or
  #   refusing with the tier's 429/400) before deployment selection. Fail-open:
  #   any Moira error leaves the request unchanged and the moira/<tier> alias
  #   deployments below serve their static default model.
  # - deployment_adapter adapts each deployment attempt from the selected
  #   deployment's model_info (see the supports_forced_tool_choice note above).
  # - tool_description_sanitizer drops `description: null` from function tools
  #   (LiteLLM's MCP conversion emits it; llama.cpp b11223+ rejects it).
  # - tool_call_content_normalizer sends `content: null` for tool-call-only
  #   assistant turns; LiteLLM otherwise turns their "" into a "[System: Empty
  #   message content sanitised…]" text block that Anthropic models imitate.
  # - spend_log_response_id makes logged response ids unique for deployments
  #   with model_info `unique_response_ids: false` (Ollama Cloud's 3-digit
  #   `chatcmpl-NNN` ids collided and their spend rows were dropped).
  # - importing the module also clears empty legacy `function_call` deltas
  #   from every stream (CodeBuddy sends one per tool call; LiteLLM's chunk
  #   builder then fails and /v1/responses clients get an error at the end).
  callbacks:
    - aether_hooks.chat_reasoning_effort
    - aether_hooks.moira_router
    - aether_hooks.deployment_adapter
    - aether_hooks.tool_description_sanitizer
    - aether_hooks.tool_call_content_normalizer
    - aether_hooks.spend_log_response_id
  turn_off_message_logging: false
  set_verbose: false
  json_logs: true
  # Per-request upstream timeout. 120s gives agentic reasoning/tool-planning
  # turns room to finish while still bounding a genuinely hung cloud provider.
  request_timeout: 120

router_settings:
  # `model_name` creates the deployment pool. Multi-leg pools use weighted
  # shuffle: the router's same-group retry that EXCLUDES the failed leg
  # (`_maybe_run_weighted_failover`) only runs under simple-shuffle, so under
  # latency routing a request that drew a quota-dead or out-of-credit leg
  # retried the same leg three times and failed (glm-5.3 via Ollama, spark
  # via clinepass, 2026-09-03). Latency routing also preferred the dead leg:
  # its error was the fastest response in the group.
  # A single failed request trips a deployment (allowed_fails 1, which also
  # disables LiteLLM's own single-deployment exemption). Only the legs of the
  # multi-leg router/* pools set cooldown_time 300, so a quota-dead leg is
  # skipped while it recovers. Every other route has one deployment: a long
  # cooldown there adds no capacity and turns a blip into 5m of "No
  # deployments available" 429s (llama-swap context overflow 2026-09-25; the
  # Muse bridge rollout gap 2026-10-09), so the router default is 5 s, which
  # only stops a broken route being hammered. LiteLLM reads 0 as its 5 s
  # default, so 5 is written out. Moira's quota meters and refusal cooldown
  # steer around exhausted providers.
  allowed_fails: 1
  cooldown_time: 5
  # Retry initial requests across the configured GLM pools when needed.
  num_retries: 3
  max_fallbacks: 3
  timeout: 120
  retry_after: 0
  debug_level: INFO
  routing_strategy: simple-shuffle
  enable_weighted_failover: true
  routing_groups:
    - group_name: router/glm-5.3-flash
      models: ["router/glm-5.3-flash"]
      routing_strategy: simple-shuffle
    - group_name: router/deepseek-v4-pro
      models: ["router/deepseek-v4-pro"]
      routing_strategy: simple-shuffle
    - group_name: router/minimax-m3
      models: ["router/minimax-m3"]
      routing_strategy: simple-shuffle
    - group_name: router/muse-spark-1.3
      models: ["router/muse-spark-1.3"]
      routing_strategy: simple-shuffle
    - group_name: router/muse-spark-1.3-contributor
      models: ["router/muse-spark-1.3-contributor"]
      routing_strategy: simple-shuffle
    # Weighted shuffle, not latency: the Ollama leg's quota error was the
    # fastest response in the group, so latency routing kept choosing it.
    - group_name: router/glm-5.3
      models: ["router/glm-5.3"]
      routing_strategy: simple-shuffle
    - group_name: router/mimo-v2.6-pro
      models: ["router/mimo-v2.6-pro"]
      routing_strategy: simple-shuffle
    - group_name: router/mimo-v2.6-flash
      models: ["router/mimo-v2.6-flash"]
      routing_strategy: simple-shuffle
    - group_name: router/family
      models: ["router/family"]
      routing_strategy: simple-shuffle

general_settings:
  store_prompts_in_spend_logs: true
  # Raw prompts/responses make SpendLogs large (~19 GiB after 592k rows).
  # Daily aggregate tables retain cost history; bound the raw audit detail.
  maximum_spend_logs_retention_period: "7d"
  maximum_spend_logs_retention_interval: "1d"

mcp_servers:
  time:
    url: "http://localhost:8003/mcp"
  firecrawl:
    url: "http://firecrawl.firecrawl.svc.cluster.local:3007/mcp"
    # MCP calls default to a 60 s cap (LITELLM_MCP_CLIENT_TIMEOUT). Searches
    # that scrape several pages overrun it (15 Firecrawl timeouts on
    # 2026-09-25), and the 504 LiteLLM returns closes the caller's whole MCP
    # session. 110 s stays under Foundry's 120 s MCP read timeout.
    timeout: 110
  # coingecko:
  #   url: "http://localhost:8002/"
  finviz:
    url: "http://localhost:8000/mcp"
  affine:
    url: "http://localhost:8005/mcp"
    auth_type: bearer_token
    auth_value: "${affine_mcp_http_token}"
  colony:
    # Colony control plane. LiteLLM fetches and refreshes Keycloak
    # client-credentials tokens itself (client colony-litellm, keycloak.tf).
    url: "https://colony.home.shdr.ch/mcp"
    auth_type: oauth2
    oauth2_flow: client_credentials
    client_id: "colony-litellm"
    client_secret: "${colony_mcp_client_secret}"
    token_url: "https://auth.shdr.ch/realms/aether/protocol/openid-connect/token"
  espn:
    url: "http://localhost:8080/mcp"
  tmdb:
    url: "http://localhost:8006/mcp"
  jellyfin:
    url: "http://localhost:8007/mcp"
  deskplane:
    url: "http://deskplane-mcp.deskplane.svc.cluster.local:8100/mcp"
  # Siren: 74 tools generated from its gRPC contract.
  # Cluster DNS, not mcp.siren.home.shdr.ch -- that hostname is reserved in the
  # namespace contract but has no Caddy vhost (the wildcard is single-label).
  siren:
    url: "http://siren-mcp.siren.svc.cluster.local:8082/mcp"
%{ if google_maps_enabled ~}
  google_maps:
    url: "http://localhost:8004/mcp"
%{ endif ~}
