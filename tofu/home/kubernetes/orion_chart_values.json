{
  "deploymentMetadata": {
    "labels": {
      "app": "orion"
    },
    "annotations": {
      "keel.sh/matchTag": "true",
      "keel.sh/policy": "force",
      "keel.sh/trigger": "poll",
      "kubernetes.io/change-cause": "keel automated update, version latest -> latest [2026-08-16T03:16:03Z]"
    }
  },
  "deploymentSpec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "orion"
      }
    },
    "strategy": {
      "type": "Recreate"
    },
    "template": {
      "metadata": {
        "annotations": {
          "aether.shdr.ch/env-checksum": "ea4de91fc760b00e4178f93ade876cb60d98a9bbdadfc807d34dd0c7c25975d1"
        },
        "labels": {
          "app": "orion"
        }
      },
      "spec": {
        "automountServiceAccountToken": true,
        "containers": [
          {
            "envFrom": [
              {
                "secretRef": {
                  "name": "orion-env",
                  "optional": false
                }
              }
            ],
            "image": "registry.gitlab.home.shdr.ch/so/orion/main:3a062f6c73231cb6065beb1cad707e7e02142ffe",
            "imagePullPolicy": "Always",
            "name": "orion",
            "ports": [
              {
                "containerPort": 3000,
                "name": "http",
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/login",
                "port": 3000,
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 5,
              "periodSeconds": 15,
              "successThreshold": 1,
              "timeoutSeconds": 1
            },
            "resources": {
              "limits": {
                "cpu": "500m",
                "memory": "512Mi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/vault",
                "mountPropagation": "None",
                "name": "vault"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "enableServiceLinks": false,
        "imagePullSecrets": [
          {
            "name": "orion-gitlab-registry"
          }
        ],
        "priorityClassName": "aether-app",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "shareProcessNamespace": false,
        "terminationGracePeriodSeconds": 30,
        "volumes": [
          {
            "name": "vault",
            "persistentVolumeClaim": {
              "claimName": "orion-vault"
            }
          }
        ]
      }
    }
  },
  "serviceMetadata": {
    "labels": {
      "app": "orion"
    },
    "annotations": {}
  },
  "serviceSpec": {
    "clusterIP": "10.107.17.60",
    "clusterIPs": [
      "10.107.17.60"
    ],
