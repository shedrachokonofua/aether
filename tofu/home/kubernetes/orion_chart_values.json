    "ipFamilyPolicy": "SingleStack",
    "ports": [
      {
        "name": "http",
        "port": 3000,
        "protocol": "TCP",
        "targetPort": 3000
      }
    ],
    "selector": {
      "app": "orion"
    },
    "sessionAffinity": "None",
    "type": "ClusterIP"
