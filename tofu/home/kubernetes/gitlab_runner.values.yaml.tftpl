gitlabUrl: ${gitlab_url}
replicas: 4
concurrent: 1
checkInterval: 3
priorityClassName: ${priority_class_name}


# Prefer different nodes for manager pods; ScheduleAnyway still allows 2+ on one node if the scheduler must
topologySpreadConstraints:
  - maxSkew: 1
    topologyKey: kubernetes.io/hostname
    whenUnsatisfiable: ScheduleAnyway
    labelSelector:
      matchLabels:
        app: ${runner_app_label}

# Keep manager pods on the x86 CI nodes.
affinity:
  nodeAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values:
                - talos-trinity
                - talos-neo
                - talos-niobe
                - talos-smith

rbac:
  create: true

serviceAccount:
  create: true
  name: ${service_account_name}

resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 512Mi

runners:
  secret: ${runner_secret_name}
  config: |
    [[runners]]
      executor = "kubernetes"
      limit = 1
      request_concurrency = 1
      builds_dir = "/ci/builds"
      cache_dir = "/ci/cache"
      environment = ["FF_NETWORK_PER_BUILD=1", "STORAGE_DRIVER=overlay", "TMPDIR=/ci/tmp", "CACHE_COMPRESSION_FORMAT=tarzstd", "CACHE_COMPRESSION_LEVEL=fastest"]

      # TMPDIR=/ci/tmp must stay on the CI disk (virtio3); the previous
      # emptyDir overlay silently routed TMPDIR writes to the node root disk
      # where etcd lives, inflating the 2026-07-31 vzdump dirty set to 108 GiB.
      # Create it through the hostPath so it stays on the CI disk with no
      # node-side prerequisite.
      # /ci is a shared hostPath, so nothing removes TMPDIR leftovers from
      # canceled or killed jobs (post_build_script never runs for those).
      # 2026-10-31: ~44k stale buildah/container-storage dirs filled neo's
      # CI disk to 96% and failed image builds with ENOSPC. Every job prunes
      # entries untouched for 24h; no job runs that long. Missing `find`
      # or a concurrent prune must not fail the job.
      pre_build_script = """
      mkdir -p /ci/tmp
      find /ci/tmp -mindepth 1 -maxdepth 1 -mmin +1440 -exec rm -rf {} + 2>/dev/null || true
      """

      [runners.kubernetes]
        namespace = "${namespace}"
        image = "alpine:3.20"
        privileged = true
        # neo ran at 95% CPU requested but 27% used (2026-10-31): a 2 CPU
        # request reserved cores jobs left idle. Request 1, keep the 2 CPU limit.
        cpu_request = "1"
        memory_request = "2Gi"
        ephemeral_storage_request = "8Gi"
        cpu_limit = "2"
        memory_limit = "4Gi"
        ephemeral_storage_limit = "32Gi"
        helper_cpu_request = "100m"
        helper_memory_request = "128Mi"
        helper_ephemeral_storage_request = "512Mi"
        helper_cpu_limit = "2"
        helper_memory_limit = "512Mi"
        helper_ephemeral_storage_limit = "1Gi"
        service_cpu_request = "100m"
        service_memory_request = "128Mi"
        service_ephemeral_storage_request = "512Mi"
        # Test services (postgres:17, rustfs) were capped at half a core and
        # 512Mi, so cargo test spent its time waiting on the database. 2 CPU /
        # 2Gi lets them run; requests stay small so they still pack next to
        # the build container.
        service_cpu_limit = "2"
        service_memory_limit = "2Gi"
        service_ephemeral_storage_limit = "1Gi"
        # A rust-test job asks for 6 CPU / 12Gi. 8 / 16Gi is the largest
        # overwrite that still fits the namespace quota.
        cpu_request_overwrite_max_allowed = "8"
        memory_request_overwrite_max_allowed = "16Gi"
        ephemeral_storage_request_overwrite_max_allowed = "16Gi"
        cpu_limit_overwrite_max_allowed = "8"
        memory_limit_overwrite_max_allowed = "16Gi"
        ephemeral_storage_limit_overwrite_max_allowed = "64Gi"
        poll_timeout = 1800
        pull_policy = "if-not-present"
        priority_class_name = "${priority_class_name}"

        # Job/helper containers ignore SIGTERM after the build has finished and
        # ride out the full default 30s grace; the ResourceQuota counts those
        # Terminating pods, so churn overlap was rejecting new job pods
        # (backtested 2026-08-01: ~30-45s effective tail explained 78/102
        # historical quota rejections). 5s keeps teardown prompt without
        # cutting anything alive.
        pod_termination_grace_period_seconds = 5
        cleanup_grace_period_seconds = 5

        # CI depends on the in-cluster GitLab endpoint for source, registry, and
        # artifacts. Pin its stable service address so CoreDNS forwarding
        # outages cannot strand runner jobs before their scripts execute.
        [[runners.kubernetes.host_aliases]]
          ip = "10.0.2.2"
          hostnames = ["gitlab.home.shdr.ch", "registry.gitlab.home.shdr.ch"]

        [runners.kubernetes.affinity]
          [runners.kubernetes.affinity.node_affinity]
            [runners.kubernetes.affinity.node_affinity.required_during_scheduling_ignored_during_execution]
              [[runners.kubernetes.affinity.node_affinity.required_during_scheduling_ignored_during_execution.node_selector_terms]]
                [[runners.kubernetes.affinity.node_affinity.required_during_scheduling_ignored_during_execution.node_selector_terms.match_expressions]]
                  key = "kubernetes.io/hostname"
                  operator = "In"
                  values = ["talos-trinity", "talos-neo", "talos-niobe", "talos-smith"]

        [[runners.kubernetes.volumes.host_path]]
          name = "ci"
          mount_path = "/ci"
          host_path = "/var/mnt/ci"

