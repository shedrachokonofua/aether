          "queryType": "sql",
          "rawSql": "SELECT toStartOfInterval(TimeUnix, INTERVAL greatest($__interval_s, 60) SECOND) AS time, 'Total' AS series, avg(Value) AS value FROM otel.otel_metrics_gauge WHERE MetricName='pbs_size' AND Attributes['datastore'] = '$Store' AND TimeUnix BETWEEN $__fromTime AND $__toTime GROUP BY time, series ORDER BY time",
