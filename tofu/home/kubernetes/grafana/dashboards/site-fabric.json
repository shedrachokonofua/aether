          "format": 0,
          "rawSql": "SELECT time, series, sum(d) / any(step) AS value FROM (SELECT toStartOfInterval(TimeUnix, INTERVAL greatest($__interval_s, 60) SECOND) AS time, greatest($__interval_s, 60) AS step, concat('RX ', Attributes['site'], '/', Attributes['host'], ' <- ', Attributes['peer_site'], '/', Attributes['peer_host']) AS series, Value - lagInFrame(Value, 1, Value) OVER w AS raw_d, if(raw_d < 0, Value, raw_d) AS d0, if(row_number() OVER w = 1, 0, d0) AS d FROM otel.otel_metrics_sum WHERE MetricName = 'wireguard_received_bytes_total' AND TimeUnix BETWEEN $__fromTime - INTERVAL 10 MINUTE AND $__toTime AND Attributes['fabric'] = 'aether' AND ServiceName = 'site-wireguard-exporter' WINDOW w AS (PARTITION BY ServiceName, ResourceAttributes, Attributes ORDER BY TimeUnix ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)) WHERE time >= $__fromTime GROUP BY time, series ORDER BY time, series",
          "refId": "A",
          "queryType": "sql",
          "editorType": "sql"
        },
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "format": 0,
          "rawSql": "SELECT time, series, sum(d) / any(step) AS value FROM (SELECT toStartOfInterval(TimeUnix, INTERVAL greatest($__interval_s, 60) SECOND) AS time, greatest($__interval_s, 60) AS step, concat('TX ', Attributes['site'], '/', Attributes['host'], ' -> ', Attributes['peer_site'], '/', Attributes['peer_host']) AS series, Value - lagInFrame(Value, 1, Value) OVER w AS raw_d, if(raw_d < 0, Value, raw_d) AS d0, if(row_number() OVER w = 1, 0, d0) AS d FROM otel.otel_metrics_sum WHERE MetricName = 'wireguard_sent_bytes_total' AND TimeUnix BETWEEN $__fromTime - INTERVAL 10 MINUTE AND $__toTime AND Attributes['fabric'] = 'aether' AND ServiceName = 'site-wireguard-exporter' WINDOW w AS (PARTITION BY ServiceName, ResourceAttributes, Attributes ORDER BY TimeUnix ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)) WHERE time >= $__fromTime GROUP BY time, series ORDER BY time, series",
          "refId": "B",
          "queryType": "sql",
          "editorType": "sql"
        }
