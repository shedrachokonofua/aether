    {
      "type": "table",
      "title": "VM / LXC certificate expiry",
      "description": "Leaf and chain certificates exported from watched files, soonest first.",
      "id": 8,
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT Attributes['host_name'] AS host_name, Attributes['subject_CN'] AS subject_CN, Attributes['issuer_CN'] AS issuer_CN, Attributes['filepath'] AS filepath, min((v-toUnixTimestamp(now()))/86400) AS value FROM (SELECT Attributes, argMax(Value, TimeUnix) AS v FROM otel.otel_metrics_gauge WHERE MetricName='x509_cert_not_after' AND TimeUnix > now() - INTERVAL 5 MINUTE GROUP BY Attributes, ResourceAttributes['service.instance.id']) GROUP BY host_name, subject_CN, issuer_CN, filepath ORDER BY value",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "green",
                "value": 14
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "days",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "days",
              "host_name": "host",
              "subject_CN": "subject",
              "issuer_CN": "issuer",
              "filepath": "file"
            }
          }
        }
      ]
    },
