    {
      "type": "table",
      "title": "Renewal units",
      "description": "Current active state for monitored certificate renewal services and timers.",
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT Attributes['host_name'] AS host_name, Attributes['name'] AS name, max(v) AS value FROM (SELECT Attributes, argMax(Value, TimeUnix) AS v FROM otel.otel_metrics_gauge WHERE MetricName='systemd_unit_state' AND Attributes['state']='active' AND match(Attributes['name'], '(backrest-cert-renew|openbao-cert-renew|step-ca-cert-renew)\\\\.(service|timer)') AND TimeUnix > now() - INTERVAL 5 MINUTE GROUP BY Attributes, ResourceAttributes['service.instance.id']) GROUP BY host_name, name ORDER BY host_name, name",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "inactive"
                },
                "1": {
                  "color": "green",
                  "text": "active"
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "state",
              "host_name": "host",
              "name": "unit"
            }
          }
        }
      ]
    },
