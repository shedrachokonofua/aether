     },
     "editorType": "sql",
     "format": 1,
     "queryType": "sql",
     "rawSql": "SELECT ifNull(sum(d),0) AS value FROM (SELECT TimeUnix, Value - lagInFrame(Value, 1, Value) OVER w AS raw_d, if(row_number() OVER w=1, 0, if(raw_d<0, Value, raw_d)) AS d FROM otel.otel_metrics_gauge WHERE MetricName='k8s.container.restarts' AND ResourceAttributes['k8s.namespace.name']='matrix' AND ResourceAttributes['k8s.container.name']='synapse' AND TimeUnix BETWEEN now() - INTERVAL 70 MINUTE AND now() WINDOW w AS (PARTITION BY ServiceName, ResourceAttributes, Attributes ORDER BY TimeUnix)) WHERE TimeUnix > now() - INTERVAL 1 HOUR",
     "refId": "A"
    }
   ],
   "title": "Synapse container restarts (1h)",
   "type": "stat"
