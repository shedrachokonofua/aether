     "editorType": "sql",
     "format": 1,
     "queryType": "sql",
     "rawSql": "SELECT ifNull(sum(v),0) AS value FROM (SELECT argMax(Value,TimeUnix) AS v FROM otel.otel_metrics_gauge WHERE MetricName='k8s.container.ready' AND ResourceAttributes['k8s.namespace.name']='matrix' AND ResourceAttributes['k8s.container.name']='synapse' AND TimeUnix > now() - INTERVAL 5 MINUTE GROUP BY ResourceAttributes['k8s.pod.name'], ResourceAttributes['k8s.container.name'])",
     "refId": "A"
    }
   ],
   "title": "Synapse containers ready",
   "type": "stat"
