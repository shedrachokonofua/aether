apiVersion: 1

# This heartbeat was briefly routed to Inquest. Delete the stale receiver so
# the intentional three-minute DeadMansSwitch remains Uptime Kuma-only.
deleteContactPoints:
  - orgId: 1
    uid: inquest-deadman

contactPoints:
  - orgId: 1
    name: apprise-standard
    receivers:
      - uid: apprise-standard
        type: webhook
        settings:
          url: "https://apprise.home.shdr.ch/notify/aether?tags=standard&:message=body"
          httpMethod: POST
        disableResolveMessage: false
      # Inquest mirrors every actionable aether alert into the incident workflow.
      - uid: inquest-standard
        type: webhook
        settings:
          url: "https://kestra.home.shdr.ch/api/v1/main/executions/webhook/aether.inquest/alert-intake/${inquest_webhook_key}"
          httpMethod: POST
        disableResolveMessage: false

  - orgId: 1
    name: apprise-critical
    receivers:
      - uid: apprise-critical
        type: webhook
        settings:
          url: "https://apprise.home.shdr.ch/notify/aether?tags=critical&:message=body"
          httpMethod: POST
        disableResolveMessage: false
      # Inquest: parallel investigation path (issue + Holmes). Ack must stay fast.
      # URL path key is the Kestra webhook trigger secret (SOPS inquest.webhook_key).
      - uid: inquest-webhook
        type: webhook
        settings:
          url: "https://kestra.home.shdr.ch/api/v1/main/executions/webhook/aether.inquest/alert-intake/${inquest_webhook_key}"
          httpMethod: POST
        disableResolveMessage: false

  - orgId: 1
    name: apprise-digest
    receivers:
      - uid: apprise-digest
        type: webhook
        settings:
          url: "https://apprise.home.shdr.ch/notify/aether?tags=quiet&:message=body"
          httpMethod: POST
          # Compact body. The default lists every label and annotation of every
          # alert; a 100-alert group exceeded the Matrix event size (error 413)
          # and the whole digest was dropped, twice a day.
          message: |-
            {{ len .Alerts.Firing }} firing, {{ len .Alerts.Resolved }} resolved
            {{ range .Alerts }}- [{{ .Status }}] {{ .Labels.alertname }}{{ if .Annotations.summary }}: {{ .Annotations.summary }}{{ end }}
            {{ end }}
        disableResolveMessage: false
      - uid: inquest-digest
        type: webhook
        settings:
          url: "https://kestra.home.shdr.ch/api/v1/main/executions/webhook/aether.inquest/alert-intake/${inquest_webhook_key}"
          httpMethod: POST
        disableResolveMessage: false

  - orgId: 1
    name: apprise-security
    receivers:
      - uid: apprise-security
        type: webhook
        settings:
          url: "https://apprise.home.shdr.ch/notify/aether?tags=security&:message=body"
          httpMethod: POST
          # Compact body. The default lists every label and annotation of every
          # alert; a 100-alert group exceeded the Matrix event size (error 413)
          # and the whole digest was dropped, twice a day.
          message: |-
            {{ len .Alerts.Firing }} firing, {{ len .Alerts.Resolved }} resolved
            {{ range .Alerts }}- [{{ .Status }}] {{ .Labels.alertname }}{{ if .Annotations.summary }}: {{ .Annotations.summary }}{{ end }}
            {{ end }}
        disableResolveMessage: false
      - uid: inquest-security
        type: webhook
        settings:
          url: "https://kestra.home.shdr.ch/api/v1/main/executions/webhook/aether.inquest/alert-intake/${inquest_webhook_key}"
          httpMethod: POST
        disableResolveMessage: false

  - orgId: 1
    name: kuma-deadman
    receivers:
      - uid: kuma-deadman
        type: webhook
        settings:
          url: "https://status.shdr.ch/api/push/${uptime_kuma_deadman_push_token}?status=up&msg=OK"
          httpMethod: POST
        disableResolveMessage: true
