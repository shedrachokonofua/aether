            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Sessions by state",
