          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Webhook deliveries",
      "gridPos": {
        "h": 8,
