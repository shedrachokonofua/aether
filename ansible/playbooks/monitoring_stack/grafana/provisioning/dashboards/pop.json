{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "expr": "{service_namespace=\"pop\"} | json | type=~\"deploy\\..*|alias\\.updated\"",
        "hide": false,
        "iconColor": "blue",
        "name": "Deploy & alias events",
        "showIn": 0,
        "textFormat": "{{project}} {{deploy_id}}",
        "titleFormat": "{{type}}"
      }
    ]
  },
  "description": "pop platform overview (plan 05 T4): requests/404 per project, latency, RGW/function/schedule/form/webhook/browser panels; deploy and alias events as Loki annotations from the structured OTLP log records (spec \u00a7Observability). Metric names are the Prometheus translations of crates/pop-sender/src/otel.rs; deploy_id and alias names are never labels.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Request rate per project (metric pop.http.requests).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "editorMode": "code",
          "expr": "sum by (project) (rate(pop_http_requests_total{project=~\"$project\"}[$__rate_interval]))",
          "legendFormat": "{{project}}",
          "refId": "A"
        }
      ],
      "title": "Requests per project",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "404s per project: unresolvable hosts and unknown paths at the serving edge (status_class=\"4xx\").",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "editorMode": "code",
          "expr": "sum by (project) (rate(pop_http_requests_total{project=~\"$project\",status_class=\"4xx\"}[$__rate_interval]))",
          "legendFormat": "{{project}}",
          "refId": "A"
        }
      ],
      "title": "404s per project",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Request latency quantiles from the pop.http.duration histogram.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(pop_http_duration_seconds_bucket{project=~\"$project\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pop_http_duration_seconds_bucket{project=~\"$project\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pop_http_duration_seconds_bucket{project=~\"$project\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Request latency",
      "type": "timeseries"
    },
