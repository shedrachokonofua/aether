    {
      "type": "table",
      "title": "Argos candidate findings",
      "id": 22,
      "description": "Evidence-backed candidate findings only. Source endpoints are resolved through network.mac_ip_history and network.mac_first_seen; a blank hostname/MAC means the address was never observed by the VyOS, GigaHub, or QSS exporters.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT f.last_evaluated_at AS time, f.finding_id, f.detector_version, splitByChar('\\n', f.subject_canonical)[1] AS source_ip, src.hostname AS source_hostname, src.mac AS source_mac, dev.first_seen AS source_first_seen, splitByChar('\\n', f.subject_canonical)[2] AS destination_ip, splitByChar('\\n', f.subject_canonical)[3] AS destination_port, splitByChar('\\n', f.subject_canonical)[4] AS protocol, f.score, f.confidence, f.summary, f.baseline_revision FROM argos.findings_current AS f LEFT JOIN ( SELECT ip, argMax(mac, last_seen) AS mac, argMax(hostname, last_seen) AS hostname FROM network.mac_ip_history GROUP BY ip ) AS src ON src.ip = lower(splitByChar('\\n', f.subject_canonical)[1]) LEFT JOIN ( SELECT mac, min(first_seen) AS first_seen FROM network.mac_first_seen GROUP BY mac ) AS dev ON dev.mac = src.mac WHERE f.detector_id = 'network-beacon' AND f.domain = 'security' AND f.disposition = 'candidate' ORDER BY f.last_evaluated_at DESC LIMIT 100",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "time",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Argos endpoint attribution coverage (%)",
      "id": 23,
      "description": "Share of current candidate findings whose source IP resolves to a known MAC. A low value means the A11 top-50 review will be mostly unattributed.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 62
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT round(100 * countIf(src.mac != '') / greatest(count(), 1), 1) AS value FROM argos.findings_current AS f LEFT JOIN ( SELECT ip, argMax(mac, last_seen) AS mac FROM network.mac_ip_history GROUP BY ip ) AS src ON src.ip = lower(splitByChar('\\n', f.subject_canonical)[1]) WHERE f.detector_id = 'network-beacon' AND f.domain = 'security' AND f.disposition = 'candidate'",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
