        "w": 6,
        "x": 0,
        "y": 47
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT ifNull(dateDiff('minute', max(ingestion_watermark), now()), 0) AS value FROM argos.detector_checkpoint_history WHERE detector_id = 'network-beacon'",
          "refId": "A",
          "format": 1
