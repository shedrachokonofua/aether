receivers:
  otlp:
    protocols:
      grpc:
        endpoint: "0.0.0.0:4317"
      http:
        endpoint: "0.0.0.0:4318"

  # Generic Loki push-API receiver: a non-OTLP bridge for tools that cannot emit
  # OTLP (currently unpoller UniFi events from home-gateway-stack); lands in
  # ClickHouse. Any Loki-push client that reaches the port is accepted — an ACL
  # restricts it to the pusher.
  loki:
    protocols:
      http:
        endpoint: "0.0.0.0:{{ vm.monitoring_stack.ports.loki_push }}"
    use_incoming_timestamp: true

  # Every scrape job (Prometheus itself was retired 2026-10-30; ClickHouse is the
  # only metrics store), including conditional probes.
  # Escape relabel replacement dollars as $$ for collector env expansion.
  prometheus:
    config:
      global:
        scrape_interval: 30s
      scrape_configs:
        - job_name: "otel-collector"
          # Collector self-metrics only. Fleet metrics arrive over OTLP.
          static_configs:
            - targets: ["localhost:8888"]


        # Physical Proxmox hosts - Node Exporter
        - job_name: "proxmox-hosts-node"
          static_configs:
            - targets:
                - "192.168.2.201:9100" # Niobe
                - "192.168.2.202:9100" # Trinity
                - "192.168.2.203:9100" # Oracle
                - "192.168.2.204:9100" # Smith
                - "192.168.2.205:9100" # Neo
              labels:
                instance_type: "proxmox_host"

        # Aether site-fabric services. Identity is fabric → site → host → service;
        # topology_role describes routing and is not part of identity.
        - job_name: "site-node-exporter"
          static_configs:
            - targets: ["10.1.0.10:9100"]
              labels:
                fabric: "aether"
                site: "aws"
                host: "link"
                service: "node-exporter"
                topology_role: "hub"
            - targets: ["10.2.0.10:9100"]
              labels:
                fabric: "aether"
                site: "gcp"
                host: "vigilant"
                service: "node-exporter"
                topology_role: "spoke"
            - targets: ["10.3.0.10:9100"]
              labels:
                fabric: "aether"
                site: "oci"
                host: "rama"
                service: "node-exporter"
                topology_role: "spoke"

        - job_name: "site-wireguard-exporter"
          static_configs:
            - targets: ["10.1.0.10:9586"]
              labels:
                fabric: "aether"
                site: "aws"
                host: "link"
                service: "wireguard-exporter"
                topology_role: "hub"
            - targets: ["10.2.0.10:9586"]
              labels:
                fabric: "aether"
                site: "gcp"
                host: "vigilant"
                service: "wireguard-exporter"
                topology_role: "spoke"
            - targets: ["10.3.0.10:9586"]
              labels:
                fabric: "aether"
                site: "oci"
                host: "rama"
                service: "wireguard-exporter"
                topology_role: "spoke"

        - job_name: "site-crowdsec"
          static_configs:
            - targets: ["10.1.0.10:6060"]
              labels:
                fabric: "aether"
                site: "aws"
                host: "link"
                service: "crowdsec"
                topology_role: "hub"

        # Physical Proxmox hosts - SMART Exporter
        - job_name: "proxmox-hosts-smart"
          scrape_interval: 60s # Less frequent for disk health
          static_configs:
            - targets:
                - "192.168.2.201:9633" # Niobe
                - "192.168.2.202:9633" # Trinity
                - "192.168.2.203:9633" # Oracle
                - "192.168.2.204:9633" # Smith
                - "192.168.2.205:9633" # Neo
              labels:
                instance_type: "proxmox_host"

        # Proxmox cluster via API - scrape each host for complete cluster view
        - job_name: "proxmox-cluster"
          static_configs:
            - targets:
                - 192.168.2.201 # Niobe
                - 192.168.2.202 # Trinity
                - 192.168.2.203 # Oracle
                - 192.168.2.204 # Smith
                - 192.168.2.205 # Neo
          metrics_path: /pve
          params:
            module: [default]
            cluster: ["1"]
            node: ["1"]
          relabel_configs:
            - source_labels: [__address__]
              target_label: __param_target
            - source_labels: [__param_target]
              target_label: instance
            - target_label: __address__
              replacement: localhost:9221 # PVE exporter in monitoring stack

        # Proxmox Backup Server
        - job_name: "proxmox-backup"
          static_configs:
            - targets: ["localhost:10019"]
              labels:
                instance_type: "pbs"

        # Ceph cluster - standalone ceph-exporter daemon (one per host, port 9926).
        # Avoids the mgr prometheus module, which crashes under Python 3.13 on
        # Ceph 19.2/20.2. Deploy with: task configure:ceph-exporter
        - job_name: "ceph"
          honor_labels: true
          static_configs:
            - targets:
                - "192.168.2.202:9926" # Trinity
                - "192.168.2.204:9926" # Smith
                - "192.168.2.205:9926" # Neo
              labels:
                instance_type: "ceph"

        # blackbox-exporter — TLS handshake probes against internal Aether-CA
        # endpoints, exports `probe_ssl_earliest_cert_expiry` so Grafana alerts
        # when a short-lived cert stops renewing (see Apr 2026 OpenBao incident).
        # Public-CA endpoints (Caddy) are covered by blackbox-http-apps.
        - job_name: "blackbox-tls"
          metrics_path: /probe
          params:
            module: [tls_connect]
          static_configs:
            - targets:
                - "{{ vm.openbao.ip }}:{{ vm.openbao.ports.https }}" # OpenBao internal TLS
                - "{{ vm.step_ca.ip }}:{{ vm.step_ca.ports.https }}" # step-ca
          relabel_configs:
            - source_labels: [__address__]
              target_label: __param_target
            - source_labels: [__param_target]
              target_label: instance
            - target_label: __address__
              replacement: localhost:9115

{% if tf_outputs.synthetic_probe_targets.value | default([]) | length > 0 %}
        # blackbox-exporter — HTTP availability probes for namespace-contract apps.
        # Targets are rendered from tf_outputs.synthetic_probe_targets (tofu output).
        - job_name: "blackbox-http-apps"
          metrics_path: /probe
          params:
            module: [http_2xx]
          static_configs:
{% for target in tf_outputs.synthetic_probe_targets.value | default([]) %}
            - targets:
                - "{{ target.url }}"
              labels:
                probe_namespace: "{{ target.namespace }}"
                probe_exposure: "{{ target.exposure }}"
                probe_criticality: "{{ target.criticality }}"
                probe_hostname: "{{ target.hostname }}"
{% endfor %}
          relabel_configs:
            - source_labels: [__address__]
              target_label: __param_target
            - source_labels: [__param_target]
              target_label: instance
            - target_label: __address__
              replacement: localhost:9115
{% endif %}

processors:
  memory_limiter:
    check_interval: 5s
    # 4096/896 (was 2048/512): the 2026-07-11 clickhouse/metrics incident — collector
    # heap hit 2374MiB and the limiter refused ALL ingest. Soft refusal is now
    # limit-spike = 3200MiB, deliberately ABOVE the container GOMEMLIMIT (3GiB) so the
    # Go GC fights heap growth before the limiter ever drops data. VM has 16GiB;
    # worst-case stack (prom 5G + otel ~4G + CH 3G) still fits.
    limit_mib: 4096
    spike_limit_mib: 896

  # Preserve absolute cumulative counters while assigning missing start times.
  metric_start_time:
    strategy: true_reset_point

  batch:
    timeout: 10s
    send_batch_size: 2048
    send_batch_max_size: 4096


  # Sealed router observations are compact NDJSON records. The dedicated
  # ClickHouse path parses them into the idempotent network.observations table.
  batch/vyos_observations:
    timeout: 5s
    send_batch_size: 10000
    send_batch_max_size: 20000

  # Selectively promote essential resource attributes to metric labels
  # This avoids the cardinality explosion from full resource_to_telemetry_conversion
  transform/metrics:
    metric_statements:
      - context: datapoint
        statements:
          # Host/service identification
          - set(attributes["host_name"], resource.attributes["host.name"]) where resource.attributes["host.name"] != nil
          - set(attributes["service_name"], resource.attributes["service.name"]) where resource.attributes["service.name"] != nil
          - set(attributes["exported_job"], resource.attributes["service.name"]) where resource.attributes["service.name"] != nil
          # Container attributes for per-container breakdown
          - set(attributes["container_name"], resource.attributes["container.name"]) where resource.attributes["container.name"] != nil
          - set(attributes["container_image_name"], resource.attributes["container.image.name"]) where resource.attributes["container.image.name"] != nil
          - set(attributes["container_id"], resource.attributes["container.id"]) where resource.attributes["container.id"] != nil
          # Tenant scoping
          - set(attributes["service_namespace"], resource.attributes["service.namespace"]) where resource.attributes["service.namespace"] != nil
          # Replica disambiguation for the remote-write path: multi-replica SDK
          # pushers (e.g. vigil) carry identity only in resource attrs, which we
          # deliberately do not convert wholesale. The old :8889 pull exporter
          # silently last-write-wins deduped such collisions; the PRW receiver
          # 400s them (out-of-order/duplicate sample) and the whole batch drops.
          # (service.instance.id needs no promotion: PRW maps it to `instance`.)
          - set(attributes["pod_name"], resource.attributes["k8s.pod.name"]) where attributes["pod_name"] == nil and resource.attributes["k8s.pod.name"] != nil
          # k8sclusterreceiver object gauges (k8s_deployment_*, k8s_hpa_*, ...)
          # carry their identity ONLY in these resource attrs. Without them every
          # object in a namespace collapses to one label set: the pull exporter
          # hid that as silent last-write-wins; remote-write 400s the duplicates
          # and drags whole batches (incl. innocent KSM series) down with them.
          - set(attributes["deployment_name"], resource.attributes["k8s.deployment.name"]) where resource.attributes["k8s.deployment.name"] != nil
          - set(attributes["statefulset_name"], resource.attributes["k8s.statefulset.name"]) where resource.attributes["k8s.statefulset.name"] != nil
          - set(attributes["daemonset_name"], resource.attributes["k8s.daemonset.name"]) where resource.attributes["k8s.daemonset.name"] != nil
          - set(attributes["replicaset_name"], resource.attributes["k8s.replicaset.name"]) where resource.attributes["k8s.replicaset.name"] != nil
          - set(attributes["cronjob_name"], resource.attributes["k8s.cronjob.name"]) where resource.attributes["k8s.cronjob.name"] != nil
          - set(attributes["job_name"], resource.attributes["k8s.job.name"]) where resource.attributes["k8s.job.name"] != nil
          - set(attributes["hpa_name"], resource.attributes["k8s.hpa.name"]) where resource.attributes["k8s.hpa.name"] != nil
          # Same collision class, per-entity receivers. hostmetrics' process
          # scraper puts the process identity only in resource attrs, so every
          # process on a host collapsed into one series (and vm-monitoring's
          # top-process panels, keyed on process_executable_name, were empty);
          # pid separates same-binary workers. kubeletstats puts the container
          # in k8s.container.name, collapsing multi-container pods.
          - set(attributes["process_executable_name"], resource.attributes["process.executable.name"]) where resource.attributes["process.executable.name"] != nil
          - set(attributes["process_pid"], String(resource.attributes["process.pid"])) where resource.attributes["process.pid"] != nil
          - set(attributes["container_name"], resource.attributes["k8s.container.name"]) where attributes["container_name"] == nil and resource.attributes["k8s.container.name"] != nil

  # Journal-forwarder logs arrive with service.name = the systemd unit and the
  # host in host.name. Rewrite service.name to the host so these sources match
  # the fleet convention (VM agents set service.name = hostname); the unit stays
  # in the journald_unit_name attribute. Scoped by instance_type, which only the
  # forwarder sets, so zeek/suricata/VM/k8s logs are untouched.
  transform/journal_forwarder_identity:
    error_mode: ignore
    log_statements:
      - context: resource
        statements:
          - set(attributes["service.name"], attributes["host.name"]) where attributes["instance_type"] != nil and attributes["host.name"] != nil

connectors:
  # Route logs based on source - single decision point
  routing/logs:
    default_pipelines: [logs/default]
    error_mode: ignore
    table:
      - context: resource
        condition: attributes["log.source"] == "zeek"
        pipelines: [logs/clickhouse/zeek]
      - context: resource
        condition: attributes["log.source"] == "suricata"
        pipelines: [logs/clickhouse/suricata]
      - context: resource
        condition: attributes["log.source"] == "vyos_observations"
        pipelines: [logs/clickhouse/vyos_observations]
      - context: resource
        condition: attributes["log.source"] == "qss_observations"
        pipelines: [logs/clickhouse/qss_observations]
      - context: resource
        condition: attributes["log.source"] == "gigahub_observations"
        pipelines: [logs/clickhouse/gigahub_observations]
      - context: resource
        # Router config-drift channel: separate log.source from the exporter's
        # vyos_observations (which is content-free by contract). Reuses the
        # clickhouse pipeline (lands in network.ingest); the 17-* MV routes it
        # by log.source='router_drift'. See clickhouse/17-router-config-snapshots.sql.
        condition: attributes["log.source"] == "router_drift"
        pipelines: [logs/clickhouse/vyos_observations]


exporters:
  # General telemetry; retention and schemas are managed by our DDL.
  clickhouse/otel:
    endpoint: tcp://localhost:9000
    username: aether
    password: "{{ secrets.clickhouse.password }}"
    database: otel
    create_schema: false
    async_insert: true
    connection_params:
      wait_for_async_insert: "1"
    compress: lz4
    logs_table_name: otel_logs
    traces_table_name: otel_traces
    metrics_tables:
      gauge:
        name: otel_metrics_gauge
      sum:
        name: otel_metrics_sum
      histogram:
        name: otel_metrics_histogram
      exponential_histogram:
        name: otel_metrics_exponential_histogram
      summary:
        name: otel_metrics_summary
    ttl: 0
    timeout: 30s
    sending_queue:
      enabled: true
      num_consumers: 1
      queue_size: 5000
    retry_on_failure:
      enabled: true
      initial_interval: 5s
      max_interval: 30s
      max_elapsed_time: 600s

  clickhouse/zeek:
    endpoint: tcp://localhost:9000
    username: aether
    password: "{{ secrets.clickhouse.password }}"
    database: zeek
    async_insert: true
    # Ack only after async buffer flush so sync MVs have materialized typed rows.
    connection_params:
      wait_for_async_insert: "1"
    compress: lz4
    create_schema: false
    logs_table_name: ingest
    timeout: 10s
    retry_on_failure:
      enabled: true
      initial_interval: 5s
      max_interval: 30s
      max_elapsed_time: 300s

  clickhouse/suricata:
    endpoint: tcp://localhost:9000
    username: aether
    password: "{{ secrets.clickhouse.password }}"
    database: suricata
    async_insert: true
    # Match Zeek: ack only after async buffer flush so sync MVs have
    # materialized typed rows. Without this, OTel can report "sent" while
    # suricata.flow/alert lag (2026-07-31 pipeline stall).
    connection_params:
      wait_for_async_insert: "1"
    compress: lz4
    create_schema: false
    logs_table_name: ingest
    # Wait-for-flush can take longer under Suricata load; keep retries alive.
    timeout: 30s
    # Bounded in-collector queue: absorb ClickHouse blips without dropping.
    # Not Kafka — batches stay in OTel memory until ack or max_elapsed_time.
    sending_queue:
      enabled: true
      num_consumers: 1
      queue_size: 5000
    retry_on_failure:
      enabled: true
      initial_interval: 5s
      max_interval: 30s
      max_elapsed_time: 600s

  clickhouse/network_observations:
    endpoint: tcp://localhost:9000
    username: aether
    password: "{{ secrets.clickhouse.password }}"
    database: network
    async_insert: true
    connection_params:
      wait_for_async_insert: "1"
    compress: lz4
    create_schema: false
    logs_table_name: ingest
    timeout: 30s
    retry_on_failure:
      enabled: true
      initial_interval: 5s
      max_interval: 30s
      max_elapsed_time: 300s


service:
  telemetry:
    logs:
      level: warn
  pipelines:
    metrics:
      receivers: [otlp]
      processors: [memory_limiter, transform/metrics, batch]
      exporters: [clickhouse/otel]

    # The receiver emits up/scrape_* series alongside scraped target metrics.
    metrics/scrape:
      receivers: [prometheus]
      processors: [memory_limiter, metric_start_time, batch]
      exporters: [clickhouse/otel]


    # Ingest logs and route based on source
    logs:
      receivers: [otlp]
      processors: [memory_limiter, transform/journal_forwarder_identity, batch]
      exporters: [routing/logs]

    # Zeek logs -> ClickHouse
    logs/clickhouse/zeek:
      receivers: [routing/logs]
      exporters: [clickhouse/zeek]

    # Suricata logs -> ClickHouse
    logs/clickhouse/suricata:
      receivers: [routing/logs]
      exporters: [clickhouse/suricata]

    # VyOS sealed NDJSON observations -> typed, replay-idempotent ClickHouse rows.
    logs/clickhouse/vyos_observations:
      receivers: [routing/logs]
      processors: [batch/vyos_observations]
      exporters: [clickhouse/network_observations]

    # qss switch observations -> ClickHouse (same table as vyos)
    logs/clickhouse/qss_observations:
      receivers: [routing/logs]
      processors: [batch/vyos_observations]
      exporters: [clickhouse/network_observations]

    # GigaHub host presence observations -> shared network observations.
    logs/clickhouse/gigahub_observations:
      receivers: [routing/logs]
      processors: [batch/vyos_observations]
      exporters: [clickhouse/network_observations]

    # All other logs -> ClickHouse otel.otel_logs (default)
    logs/default:
      receivers: [routing/logs]
      exporters: [clickhouse/otel]

    # Non-OTLP Loki-push sources (unpoller UniFi events), routed through the
    # collector so they get batching, memory limiting, and the standard egress.
    logs/loki_push:
      receivers: [loki]
      processors: [memory_limiter, batch]
      exporters: [clickhouse/otel]

    traces:
      receivers: [otlp]
      processors: [memory_limiter, batch]
      exporters: [clickhouse/otel]
