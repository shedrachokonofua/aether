{
  "version": 4,
  "modno": 1,
  "instance": "backup-stack",
  "repos": [
    {
      "id": "offsite-s3",
      "uri": "{{ restic_repository }}",
      "password": "{{ restic_password }}",
      "autoInitialize": true,
      "flags": [
        "-o", "rclone.program=/usr/bin/rclone",
        "-o", "rclone.connections=16"
      ],
      "prunePolicy": {
        "maxUnusedPercent": 25
      }
    }
  ],
  "plans": [
{% for path in backup_paths %}
    {
      "id": "backup-{{ path | basename }}",
      "repo": "offsite-s3",
      "paths": ["{{ path }}"],
{% if path | basename == "backups-vm" %}
      "backup_flags": ["--compression", "off", "--read-concurrency", "4"],
{% endif %}
      "schedule": {
        "cron": "{{ backrest_backup_cron }}",
        "clock": "LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 7,
          "weekly": 4,
          "monthly": 6
        }
      }
    }{{ "," if not loop.last else "" }}
{% endfor %}
  ],
  "auth": {
    "disabled": true
  }
}
